---
layout: base.njk
permalink: /internal.html
title: Internal Dashboard
description: Shortcuts to the apps EISS staff, board members and volunteers use. Every app asks for sign-in.
navKey: ""
lang: en
noindex: true
searchExclude: true
eleventyExcludeFromCollections: true
---
{#
  internal.njk: the apps dashboard for staff, board members and volunteers,
  after Google Workspace's "Your apps" page. internal.eiss-europa.com
  redirects here from a separate one-file repo (GitHub Pages serves one
  custom domain per repo).

  Reads: site.staffLinks (entries with `roles`), labels t.staffMenu.<key> or
  the entry's own `label`, site.guideLinks, systemHealth and dashboard (release,
  counts, dates, deadlines, phase).
  The role filter is CSS `:has()` on data-roles, so it works without JS. So does
  the page, with every tab's section stacked.
  A shortcut list, not access control. Everything works without JS: the script
  only adds the first-visit prompt, greeting, clock, live day counts, app count,
  remembered role, Today line, live GitHub figures, card spotlight and the hero
  constellation. Without it the strip shows the figures of the last build.
  #admin: an unlisted view (site.adminLinks) shown by CSS `:target`. Hidden
  from view, not secret: the links are in the source of this public page.

  ponytail: EN only. Its readers work in English. Add .fr/.de siblings when
  someone asks for them, hand-translated (CLAUDE.md §1).
#}
{% from "icons.njk" import icon %}
{%- set t = i18n[lang or "en"] -%}

{# Opens the connection to Indico ahead of the click. #}
<link rel="preconnect" href="https://indico.eiss-europa.com">
<div class="apps-page">
  <p class="sr-only" role="status" data-apps-status></p>
  <header class="apps-hero" data-apps-hero>
    <canvas class="apps-hero-canvas" aria-hidden="true"></canvas>
    <div class="container apps-hero-inner">
      <div class="apps-hero-logo">{% inlineSvg "assets/images/brand/eiss-10-lockup.svg" %}</div>
      <h1 class="apps-hero-title">{{ t.staffMenu.heading }}</h1>
      <p class="apps-hero-clock" data-apps-clock hidden></p>
      <p class="apps-hero-lead">Shortcuts to the apps EISS uses. Each one asks you to sign in, with your eiss-europa.com account for the Google apps.</p>
    </div>
  </header>

  <div class="container">
    <div class="apps-first" data-apps-first hidden>
      <p class="apps-first-title" id="apps-first-title">Which describes you?</p>
      <div class="apps-first-choices" role="group" aria-labelledby="apps-first-title">
        <button type="button" class="btn btn-secondary btn-sm" data-apps-choose="staff">Staff</button>
        <button type="button" class="btn btn-secondary btn-sm" data-apps-choose="management">Management</button>
        <button type="button" class="btn btn-secondary btn-sm" data-apps-choose="board">Board member</button>
        <button type="button" class="btn btn-secondary btn-sm" data-apps-choose="volunteer">Volunteer</button>
        <button type="button" class="btn btn-secondary btn-sm" data-apps-choose="all">Show all</button>
      </div>
    </div>

    <dl class="apps-stats">
      {% set deadline = dashboard.deadlines[0] %}
      {% if deadline %}
        <div class="apps-stat" data-apps-deadline>
          <dt data-apps-deadline-label>{{ deadline.label }}</dt>
          <dd><a href="#status" data-apps-deadline-days>{{ deadline.date | daysUntil }} days</a></dd>
        </div>
      {% endif %}
      {% if facts.conferences.next %}
        <div class="apps-stat">
          <dt>days until ESSC {{ facts.conferences.next.startDate | truncate(4, true, "") }}, {{ facts.conferences.next.city }}</dt>
          <dd><a href="/{{ facts.conferences.next.startDate | truncate(4, true, "") }}.html" data-apps-countdown="{{ facts.conferences.next.startDate }}" data-apps-count>{{ facts.conferences.next.startDate | daysUntil }}</a></dd>
        </div>
      {% endif %}
      {% if systemHealth %}
        <div class="apps-stat{% if systemHealth.summary.url %} apps-stat-{{ systemHealth.summary.level }}{% endif %}" data-apps-systems>
          <dt>Systems</dt>
          <dd class="apps-stat-level"><span class="apps-dot apps-dot-{{ systemHealth.summary.level }}" data-apps-systems-dot aria-hidden="true"></span>{% if systemHealth.summary.url %}<a href="{{ systemHealth.summary.url }}" data-apps-systems-label>{{ systemHealth.summary.label }}</a>{% else %}<a data-apps-systems-label>{{ systemHealth.summary.label }}</a>{% endif %}</dd>
        </div>
      {% endif %}
      {% if dashboard.release %}
        <div class="apps-stat">
          <dt>{{ dashboard.release.title }}{% if dashboard.release.due %}, due {{ dashboard.release.due | newsDate("en") }}{% endif %}</dt>
          <dd><a href="{{ dashboard.release.url }}" data-apps-release-percent>{{ dashboard.release.percent }}%</a></dd>
        </div>
      {% endif %}
      {% if dashboard.counts %}
        <div class="apps-stat">
          <dt>tasks to pick up</dt>
          <dd><a href="{{ dashboard.counts[2].url }}" data-apps-live="tasks">{{ dashboard.counts[2].value }}</a></dd>
        </div>
      {% endif %}
    </dl>
    <p class="apps-live" data-apps-asof>{% if systemHealth %}Figures as of {{ systemHealth.checked | newsDate("en") }}{% endif %}</p>
    <p class="apps-today" data-apps-today hidden></p>

    {% if dashboard.phase %}
      <section class="apps-phase" aria-labelledby="apps-phase-title">
        <div>
          <h2 class="apps-phase-title" id="apps-phase-title">Now: {{ dashboard.phase.label }}</h2>
          <p class="apps-note">{{ dashboard.phase.note }}</p>
        </div>
        <ul class="apps-phase-links" role="list">
          {% for l in dashboard.phase.links %}
            <li data-roles="{{ l.roles | join(' ') }}"><a class="btn btn-secondary btn-sm" href="{{ l.href }}">{{ icon(l.icon) }} {{ l.label or t.staffMenu[l.key] }}</a></li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    <div class="apps-admin" id="admin">
      <h2 class="apps-heading">Admin</h2>
      <ul class="apps-grid" role="list">
        {% for app in site.adminLinks %}
          <li class="apps-card-wrap" style="--n: {{ loop.index0 }}">
            <a class="apps-tile" href="{{ app.href }}">
              <span class="apps-icon">{{ icon(app.icon) }}</span>
              <span class="apps-label">{{ app.label }}</span>
              <span class="apps-go">{{ icon("arrow-right") }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>

    <div class="apps-tabbar">
      <div class="apps-tabs" role="tablist" aria-label="Dashboard sections" data-apps-tabs hidden>
        <button type="button" role="tab" id="apps-tab-apps" aria-controls="apps" data-apps-tab="apps">Apps</button>
        <button type="button" role="tab" id="apps-tab-status" aria-controls="status" data-apps-tab="status">Project status</button>
        <button type="button" role="tab" id="apps-tab-guides" aria-controls="guides" data-apps-tab="guides">Guides</button>
        {% if systemHealth %}<button type="button" role="tab" id="apps-tab-it" aria-controls="it" data-apps-tab="it" data-roles="staff">IT monitoring <span class="apps-dot apps-dot-{{ systemHealth.summary.level }}" data-apps-it-dot aria-hidden="true"{% if not systemHealth.summary.url %} hidden{% endif %}></span><span class="sr-only" data-apps-it-note{% if not systemHealth.summary.url %} hidden{% endif %}>, needs attention</span></button>{% endif %}
      </div>
      <div class="apps-viewing">
        <label for="apps-role">Viewing as</label>
        <select class="apps-role" id="apps-role">
          <option value="all" selected>Show all</option>
          <option value="staff">Staff</option>
          <option value="management">Management</option>
          <option value="board">Board member</option>
          <option value="volunteer">Volunteer</option>
        </select>
      </div>
    </div>

    <section class="apps-panel" id="apps" data-apps-panel aria-labelledby="apps-heading">
      <div class="apps-panel-head">
        <div>
          <h2 class="apps-heading" id="apps-heading">Your apps</h2>
          <p class="apps-count" data-apps-total role="status" hidden></p>
        </div>
      </div>

      <ul class="apps-grid" role="list">
        {% set n = 0 %}
        {% for app in site.staffLinks %}{% if app.roles %}
          {% set note = app.note or t.staffMenu[app.key + "Note"] %}
          <li class="apps-card-wrap"{% if app.href %} data-apps-app{% endif %} data-roles="{{ app.roles | join(' ') }}" style="--n: {{ n }}">
            {% if app.href %}
              <a class="apps-tile" href="{{ app.href }}">
                <span class="apps-icon">{{ icon(app.icon) }}{% if app.badge %}<span class="apps-badge">{{ app.badge }}</span>{% endif %}</span>
                <span class="apps-label">{{ app.label or t.staffMenu[app.key] }}</span>
                {% if note %}<span class="apps-note">{{ note }}</span>{% endif %}
                <span class="apps-go">{{ icon("arrow-right") }}</span>
              </a>
            {% else %}
              <div class="apps-tile apps-tile-soon">
                <span class="apps-icon">{{ icon(app.icon) }}</span>
                <span class="apps-label">{{ app.label }}</span>
                {% if note %}<span class="apps-note">{{ note }}</span>{% endif %}
              </div>
            {% endif %}
          </li>
          {% set n = n + 1 %}
        {% endif %}{% endfor %}
      </ul>
    </section>

    <section class="apps-panel" id="status" data-apps-panel aria-labelledby="apps-status-heading">
      <h2 class="apps-heading apps-section-heading" id="apps-status-heading">Project status</h2>
      <div class="apps-status">
        {% if dashboard.release %}
          <div class="apps-status-card" data-roles="staff">
            <h3 class="apps-status-title">Next release</h3>
            <p class="apps-release"><a href="{{ dashboard.release.url }}">{{ dashboard.release.title }}</a>{% if dashboard.release.due %}, due {{ dashboard.release.due | newsDate("en") }}{% endif %}</p>
            <progress class="apps-progress" data-apps-release-bar value="{{ dashboard.release.closed }}" max="{{ dashboard.release.total }}" aria-label="{{ dashboard.release.title }} progress">{{ dashboard.release.percent }}%</progress>
            <p class="apps-note" data-apps-release-note>{{ dashboard.release.closed }} of {{ dashboard.release.total }} issues closed</p>
          </div>
        {% endif %}
        {% if dashboard.counts %}
          <div class="apps-status-card" data-roles="staff volunteer">
            <h3 class="apps-status-title">On GitHub</h3>
            <ul class="apps-counts" role="list">
              {% for c in dashboard.counts %}
                <li data-roles="{{ c.roles | join(' ') }}"><a href="{{ c.url }}"><strong data-apps-live="{{ ['issues', 'prs', 'tasks'][loop.index0] }}">{{ c.value }}</strong> {{ c.label }}</a></li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
        {% if dashboard.dates.length %}
          <div class="apps-status-card">
            <h3 class="apps-status-title">Key dates</h3>
            <ul class="apps-dates" role="list">
              {% for d in dashboard.dates %}
                <li data-roles="{{ d.roles | join(' ') }}"><time datetime="{{ d.date }}">{{ d.date | newsDate("en") }}</time> <span>{{ d.label }}</span></li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      </div>
    </section>

    {% if systemHealth %}
      <section class="apps-panel apps-health" id="it" data-apps-panel aria-labelledby="apps-health-heading" data-roles="staff">
        <h2 class="apps-heading apps-section-heading" id="apps-health-heading">IT System Monitoring</h2>
        <div class="apps-status">
          {% for repo in systemHealth.repos %}
            <div class="apps-status-card">
              <h3 class="apps-status-title apps-health-brand">
                <a href="{{ repo.site }}" aria-label="{{ repo.label }}">
                  {% if loop.first %}<span aria-hidden="true">{% inlineSvg "assets/images/brand/logo-lockup.svg" %}</span>{% else %}<img src="/assets/images/partners/netsec.svg#svgView(viewBox(360,780,2800,930))" alt="" width="120" height="40">{% endif %}
                </a>
              </h3>
              <p class="apps-health-level" data-apps-repo-level="{{ repo.slug }}"><span class="apps-dot apps-dot-{{ repo.level }}" aria-hidden="true"></span><span>{{ repo.levelLabel }}</span></p>
              <p class="apps-health-summary" data-apps-repo-summary="{{ repo.slug }}">{% if repo.failedCount %}{{ repo.failedCount }} of {{ repo.items.length }} automations failing{% else %}{{ repo.items.length }} automations, none failing{% endif %}</p>
              <details class="apps-health-details" data-apps-repo-details="{{ repo.slug }}"{% if repo.failedCount %} open{% endif %}>
                <summary>Every automation</summary>
                <ul class="apps-health-list" role="list">
                  {% for item in repo.items %}
                    <li class="apps-health-item{% if item.failed %} apps-health-failed{% endif %}" data-apps-run="{{ repo.slug }}|{{ item.name }}"><span class="apps-dot apps-dot-{{ item.level }}" aria-hidden="true"></span><div><a href="{{ item.url }}">{{ item.name }}</a> <span>{{ item.label }}{% if item.date %}, {{ item.date | newsDate("en") }}{% endif %}</span></div></li>
                  {% endfor %}
                </ul>
              </details>
            </div>
          {% endfor %}
          <div class="apps-status-card">
            <h3 class="apps-status-title">Google Workspace</h3>
            <p class="apps-health-level"><span class="apps-dot apps-dot-{{ systemHealth.workspace.level }}" aria-hidden="true"></span>{{ systemHealth.workspace.levelLabel }}</p>
            <ul class="apps-health-list" role="list">
              {% if systemHealth.google %}
                <li class="apps-health-item"><span class="apps-dot apps-dot-{{ systemHealth.google.level }}" aria-hidden="true"></span><div><a href="https://www.google.com/appsstatus/dashboard/">Google's services</a> <span>{{ systemHealth.google.levelLabel }}{% if systemHealth.google.services.length %}: {{ systemHealth.google.services | join(", ") }}{% endif %}</span></div></li>
              {% else %}
                <li><a href="https://www.google.com/appsstatus/dashboard/">Google's services</a> <span>Could not be read at the last build</span></li>
              {% endif %}
              {% if systemHealth.workspace.checks %}
                {% for check in systemHealth.workspace.checks %}
                  <li class="apps-health-item"><span class="apps-dot apps-dot-{{ check.level }}" aria-hidden="true"></span><div><a href="https://script.google.com/home/executions">{{ check.name }}</a> <span>{{ check.label }}{% if check.date %}, last good run {{ check.date | newsDate("en") }}{% endif %}</span></div></li>
                {% endfor %}
              {% else %}
                <li><a href="https://script.google.com/home/executions">Apps Script runs</a> <span>Could not be read at the last build</span></li>
              {% endif %}
              <li><a href="https://admin.google.com/ac/ac">Security alerts</a> <span>Not monitored here</span></li>
            </ul>
          </div>
        </div>
        <p class="apps-note" data-apps-asof>Figures as of {{ systemHealth.checked | newsDate("en") }}.</p>
      </section>
    {% endif %}

    <section class="apps-panel" id="guides" data-apps-panel aria-labelledby="apps-guides-heading">
      <h2 class="apps-heading apps-section-heading" id="apps-guides-heading">Guides</h2>
      <ul class="apps-grid" role="list">
        {% for guide in site.guideLinks %}
          <li class="apps-card-wrap" data-roles="{{ guide.roles | join(' ') }}" style="--n: {{ loop.index0 }}">
            <a class="apps-tile apps-tile-short" href="{{ guide.href }}">
              <span class="apps-icon">{{ icon(guide.icon) }}</span>
              <span class="apps-label">{{ guide.label }}</span>
              <span class="apps-go">{{ icon("arrow-right") }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </section>
  </div>
</div>

<script type="application/json" id="apps-data">{{ { deadlines: dashboard.deadlines, release: dashboard.release, counts: dashboard.counts, repo: dashboard.repo, health: systemHealth } | dump | safe }}</script>
<script>
  (function () {
    var calm = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Remember the role choice and report how many apps it leaves. The
    // filtering itself is CSS.
    var KEY = "eiss-apps-role";
    var roleSelect = document.getElementById("apps-role");
    var total = document.querySelector("[data-apps-total]");
    var saved = null;
    try { saved = localStorage.getItem(KEY); } catch (e) {}
    function tally() {
      var shown = [].filter.call(document.querySelectorAll("[data-apps-app]"), function (el) {
        return getComputedStyle(el).display !== "none";
      }).length;
      total.textContent = shown + (shown === 1 ? " app" : " apps");
      total.hidden = false;
    }
    if (saved && roleSelect.querySelector('[value="' + CSS.escape(saved) + '"]')) roleSelect.value = saved;
    roleSelect.addEventListener("change", function () {
      try { localStorage.setItem(KEY, roleSelect.value); } catch (e) {}
      tally();
      renderToday();
      keepTabVisible();
    });
    tally();

    // The first visit asks for a role under the header. The answer sets the
    // same radio as the filter, which stays available to change it later.
    var first = document.querySelector("[data-apps-first]");
    if (saved === null) first.hidden = false;
    first.addEventListener("click", function (e) {
      var value = e.target.getAttribute && e.target.getAttribute("data-apps-choose");
      if (!value) return;
      roleSelect.value = value;
      roleSelect.dispatchEvent(new Event("change"));
      first.hidden = true;
      roleSelect.focus();
    });

    // Tabs. Without this script they stay hidden and every section stacks.
    // Each has its own link, and the page always opens on Apps otherwise.
    var tablist = document.querySelector("[data-apps-tabs]");
    var tabs = [].slice.call(tablist.querySelectorAll("[role=tab]"));
    var panels = [].slice.call(document.querySelectorAll("[data-apps-panel]"));
    function isTab(name) { return tabs.some(function (t) { return t.getAttribute("data-apps-tab") === name; }); }
    function selectTab(name) {
      tabs.forEach(function (t) {
        var on = t.getAttribute("data-apps-tab") === name;
        t.setAttribute("aria-selected", on);
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach(function (panel) { panel.hidden = panel.id !== name; });
    }
    function usable() { return tabs.filter(function (t) { return getComputedStyle(t).display !== "none"; }); }
    function keepTabVisible() {
      if (usable().indexOf(tablist.querySelector('[aria-selected="true"]')) < 0) {
        selectTab("apps");
        history.replaceState(null, "", location.pathname);
      }
    }
    panels.forEach(function (panel) {
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", "apps-tab-" + panel.id);
    });
    tablist.hidden = false;
    selectTab(isTab(location.hash.slice(1)) ? location.hash.slice(1) : "apps");
    keepTabVisible();
    tablist.addEventListener("click", function (e) {
      var tab = e.target.closest("[role=tab]");
      if (!tab) return;
      var name = tab.getAttribute("data-apps-tab");
      selectTab(name);
      history.replaceState(null, "", "#" + name);
    });
    tablist.addEventListener("keydown", function (e) {
      var list = usable(), i = list.indexOf(document.activeElement);
      var to = e.key === "ArrowRight" ? (i + 1) % list.length : e.key === "ArrowLeft" ? (i - 1 + list.length) % list.length : e.key === "Home" ? 0 : e.key === "End" ? list.length - 1 : -1;
      if (to < 0) return;
      e.preventDefault();
      list[to].focus();
      list[to].click();
    });
    addEventListener("hashchange", function () {
      var name = location.hash.slice(1);
      if (!isTab(name)) return;
      selectTab(name);
      keepTabVisible();
      tablist.scrollIntoView({ block: "nearest" });
    });

    // Greeting and clock, in the reader's own time zone.
    var clock = document.querySelector("[data-apps-clock]");
    function tick() {
      var d = new Date(), h = d.getHours();
      var hello = h < 5 ? "Good evening" : h < 12 ? "Good morning" : h < 18 ? "Good afternoon" : "Good evening";
      clock.textContent = hello + ". " +
        d.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" }) + ", " +
        d.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" });
      clock.hidden = false;
      setTimeout(tick, 60000 - d.getSeconds() * 1000);
    }
    tick();

    // Day counts stay right between daily rebuilds. Figures count up once.
    function daysTo(iso) {
      var p = iso.split("-"), now = new Date();
      return Math.round((Date.UTC(p[0], p[1] - 1, p[2]) - Date.UTC(now.getFullYear(), now.getMonth(), now.getDate())) / 864e5);
    }
    function inDays(n) { return n === 0 ? "Today" : n === 1 ? "1 day" : n + " days"; }
    var cd = document.querySelector("[data-apps-countdown]");
    if (cd) {
      var days = daysTo(cd.getAttribute("data-apps-countdown"));
      if (days < 0) cd.closest(".apps-stat").hidden = true; else cd.textContent = days;
    }

    var data = JSON.parse(document.getElementById("apps-data").textContent);
    var next = (data.deadlines || []).filter(function (d) { return daysTo(d.date) >= 0; })[0];
    var tile = document.querySelector("[data-apps-deadline]");
    if (tile) {
      if (next) {
        var left = daysTo(next.date);
        tile.querySelector("[data-apps-deadline-label]").textContent = next.label;
        tile.querySelector("[data-apps-deadline-days]").textContent = inDays(left);
        tile.classList.toggle("apps-stat-critical", left <= 3);
        tile.classList.toggle("apps-stat-issue", left > 3 && left <= 14);
      } else tile.hidden = true;
    }

    // The Today line: failures first for those who see IT monitoring, then a
    // deadline inside 30 days, then what changed since the last visit. It stays
    // away when there is nothing to say.
    var failed = data.health ? data.health.summary.failed : [];
    var since = { tasks: 0, closed: 0 };
    var today = document.querySelector("[data-apps-today]");
    function renderToday() {
      var role = roleSelect.value;
      var parts = [];
      if (failed.length && (role === "all" || role === "staff")) {
        parts.push(failed.length + (failed.length === 1 ? " automation failing: " : " automations failing: ") + failed.join(", ") + ".");
      }
      if (next && daysTo(next.date) <= 30) {
        var when = new Date(next.date + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "long" });
        parts.push(next.label + ": " + when + ".");
      }
      var news = [];
      if (since.tasks > 0 && role !== "management" && role !== "board") news.push(since.tasks + (since.tasks === 1 ? " new task" : " new tasks"));
      if (since.closed > 0 && (role === "all" || role === "staff")) news.push(since.closed + " more release " + (since.closed === 1 ? "issue" : "issues") + " closed");
      if (news.length) parts.push("Since your last visit: " + news.join(", ") + ".");
      today.textContent = parts.join(" ");
      today.hidden = !parts.length;
    }

    // Since your last visit, per browser. Reloads within the hour count as the
    // same visit, so the note survives them. First visits have nothing to compare.
    function compare(tasks, closed) {
      var SEEN = "eiss-apps-seen", seen = null, t = Date.now();
      try { seen = JSON.parse(localStorage.getItem(SEEN)); } catch (e) {}
      var now = { tasks: tasks, closed: closed };
      if (!seen) seen = { at: t, prev: null, cur: now };
      else if (t - seen.at > 36e5) seen = { at: t, prev: seen.cur, cur: now };
      else seen.cur = now;
      try { localStorage.setItem(SEEN, JSON.stringify(seen)); } catch (e) {}
      since = seen.prev ? { tasks: tasks - seen.prev.tasks, closed: closed - seen.prev.closed } : { tasks: 0, closed: 0 };
      renderToday();
    }
    var built = { tasks: data.counts ? data.counts[2].value : 0, closed: data.release ? data.release.closed : 0 };
    renderToday();

    // Live figures from GitHub's public API, which allows 60 requests an hour
    // per address, hence the 10-minute cache. On any failure the build's stay.
    // ponytail: Workspace and Google stay on the daily build, no browser route is tested.
    var API = "https://api.github.com/";
    function get(path) {
      return fetch(API + path, { headers: { Accept: "application/vnd.github+json" } }).then(function (r) {
        if (!r.ok) throw new Error(r.status);
        return r.json();
      });
    }
    function count(q) {
      return get("search/issues?per_page=1&q=" + encodeURIComponent("repo:" + data.repo + " " + q)).then(function (r) { return r.total_count; });
    }
    function loadLive() {
      var repos = data.health ? data.health.repos : [];
      return Promise.all([
        count("is:issue is:open"),
        count("is:pr is:open"),
        count('is:issue is:open label:"help wanted"'),
        get("repos/" + data.repo + "/milestones?state=open&per_page=100"),
        Promise.all(repos.map(function (r) {
          return get("repos/" + r.slug + "/actions/runs?status=completed&per_page=100&branch=" + r.branch);
        })),
      ]).then(function (a) {
        var m = data.release && a[3].filter(function (x) { return x.title === data.release.title; })[0];
        return { issues: a[0], prs: a[1], tasks: a[2], closed: m ? m.closed_issues : null, total: m ? m.closed_issues + m.open_issues : null,
          runs: a[4].map(function (r) { return r.workflow_runs.map(function (w) { return { name: w.name, conclusion: w.conclusion, url: w.html_url }; }); }) };
      });
    }
    var LEVELS = { nominal: "Nominal", issue: "Issue", critical: "Critical" };
    // Run links arrive from the API or the browser's cache, so only GitHub's are followed.
    function isRun(url) { return /^https:\/\/github\.com\//.test(url); }
    function setDot(el, level) { el.className = "apps-dot apps-dot-" + level; }
    function applyHealth(live) {
      var all = [];
      data.health.repos.forEach(function (repo, i) {
        var bad = repo.items.filter(function (item) {
          // Runs are newest first, and a quiet weekly job may not be in the page: it keeps its build state.
          var run = live.runs[i].filter(function (w) { return w.name === item.name; })[0];
          if (run) {
            item.failed = ["failure", "timed_out", "startup_failure"].indexOf(run.conclusion) > -1;
            item.level = !item.failed ? "nominal" : /deploy/i.test(item.name) ? "critical" : "issue";
            item.url = run.url;
          }
          var li = [].filter.call(document.querySelectorAll("[data-apps-run]"), function (el) {
            return el.getAttribute("data-apps-run") === repo.slug + "|" + item.name;
          })[0];
          if (li) {
            li.classList.toggle("apps-health-failed", item.failed);
            setDot(li.querySelector(".apps-dot"), item.level);
            if (isRun(item.url)) li.querySelector("a").href = item.url;
            li.querySelector("span:not(.apps-dot)").textContent = LEVELS[item.level] + (run ? ", latest run" : "");
          }
          return item.failed;
        });
        var level = bad.length >= 3 || bad.some(function (b) { return b.level === "critical"; }) ? "critical" : bad.length ? "issue" : "nominal";
        all.push({ level: level, bad: bad });
        var line = document.querySelector('[data-apps-repo-level="' + repo.slug + '"]');
        if (line) { setDot(line.querySelector(".apps-dot"), level); line.lastElementChild.textContent = LEVELS[level]; }
        var sum = document.querySelector('[data-apps-repo-summary="' + repo.slug + '"]');
        if (sum) sum.textContent = bad.length ? bad.length + " of " + repo.items.length + " automations failing" : repo.items.length + " automations, none failing";
        var det = document.querySelector('[data-apps-repo-details="' + repo.slug + '"]');
        if (det && bad.length) det.open = true;
      });
      var ws = data.health.workspace.level;
      var levels = all.map(function (x) { return x.level; }).concat(ws);
      var overall = levels.indexOf("critical") > -1 ? "critical" : levels.indexOf("issue") > -1 ? "issue" : levels.indexOf("nominal") > -1 ? "nominal" : "unknown";
      var bad = all.reduce(function (acc, x) { return acc.concat(x.bad); }, []);
      failed = bad.map(function (b) { return b.name; });
      var box = document.querySelector("[data-apps-systems]");
      if (box) {
        box.className = overall === "issue" || overall === "critical" ? "apps-stat apps-stat-" + overall : "apps-stat";
        setDot(box.querySelector("[data-apps-systems-dot]"), overall);
        var label = box.querySelector("[data-apps-systems-label]");
        label.textContent = LEVELS[overall] || data.health.summary.label;
        if (overall === "issue" || overall === "critical") label.href = bad.length && isRun(bad[0].url) ? bad[0].url : "https://script.google.com/home/executions";
        else label.removeAttribute("href");
      }
      var alarm = overall === "issue" || overall === "critical";
      var dot = document.querySelector("[data-apps-it-dot]");
      setDot(dot, overall);
      dot.hidden = !alarm;
      document.querySelector("[data-apps-it-note]").hidden = !alarm;
    }
    function applyLive(live, at) {
      ["issues", "prs", "tasks"].forEach(function (k) {
        document.querySelectorAll('[data-apps-live="' + k + '"]').forEach(function (el) { el.textContent = live[k]; });
      });
      if (live.total) {
        var pct = Math.round(live.closed / live.total * 100);
        var el = document.querySelector("[data-apps-release-percent]");
        if (el) el.textContent = pct + "%";
        var bar = document.querySelector("[data-apps-release-bar]");
        if (bar) { bar.max = live.total; bar.value = live.closed; bar.textContent = pct + "%"; }
        var note = document.querySelector("[data-apps-release-note]");
        if (note) note.textContent = live.closed + " of " + live.total + " issues closed";
      }
      if (data.health) applyHealth(live);
      var mins = Math.round((Date.now() - at) / 6e4);
      var line = document.querySelector(".apps-live");
      line.classList.add("is-live");
      line.textContent = "Live from GitHub, checked " + (mins < 1 ? "just now" : mins + (mins === 1 ? " minute ago" : " minutes ago"));
      compare(live.tasks, live.closed === null ? built.closed : live.closed);
    }
    var LIVE = "eiss-apps-live", cached = null;
    try { cached = JSON.parse(localStorage.getItem(LIVE)); } catch (e) {}
    if (cached && Date.now() - cached.at < 6e5) applyLive(cached.live, cached.at);
    else loadLive().then(function (live) {
      var at = Date.now();
      try { localStorage.setItem(LIVE, JSON.stringify({ at: at, live: live })); } catch (e) {}
      applyLive(live, at);
    }).catch(function () { compare(built.tasks, built.closed); });
    if (!calm) document.querySelectorAll("[data-apps-count]").forEach(function (el) {
      var end = +el.textContent, start = performance.now();
      (function step(t) {
        var k = Math.min((t - start) / 900, 1);
        el.textContent = Math.round(end * (1 - Math.pow(1 - k, 3)));
        if (k < 1) requestAnimationFrame(step);
      })(start);
    });

    // A soft light follows the pointer across the cards.
    document.querySelectorAll(".apps-tile").forEach(function (a) {
      a.addEventListener("pointermove", function (e) {
        var r = a.getBoundingClientRect();
        a.style.setProperty("--mx", e.clientX - r.left + "px");
        a.style.setProperty("--my", e.clientY - r.top + "px");
      });
    });

    // The constellation behind the logo. It drifts for four seconds and comes
    // to rest (RGAA 13.8: motion past five seconds needs a pause control), and
    // moves again only under the reader's pointer.
    var hero = document.querySelector("[data-apps-hero]");
    var c = hero.querySelector("canvas"), ctx = c.getContext("2d");
    var nodes = [], ptr = null, until = 0, running = false, W, H, dpr;
    function size() {
      dpr = Math.min(devicePixelRatio || 1, 2);
      W = hero.clientWidth; H = hero.clientHeight;
      c.width = W * dpr; c.height = H * dpr;
      var want = Math.min(70, Math.round(W * H / 14000));
      while (nodes.length < want) nodes.push({ x: Math.random() * W, y: Math.random() * H, vx: (Math.random() - 0.5) * 0.35, vy: (Math.random() - 0.5) * 0.35 });
      nodes.length = want;
    }
    function draw(step) {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      var pts = ptr ? nodes.concat(ptr) : nodes;
      pts.forEach(function (a, i) {
        if (a !== ptr) {
          a.x = (a.x + a.vx * step + W) % W;
          a.y = (a.y + a.vy * step + H) % H;
        }
        for (var j = i + 1; j < pts.length; j++) {
          var b = pts[j], d = Math.hypot(a.x - b.x, a.y - b.y);
          if (d < 130) {
            ctx.strokeStyle = "rgba(115, 202, 255, " + (0.32 * (1 - d / 130)) + ")";
            ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
          }
        }
        ctx.fillStyle = "rgba(115, 202, 255, 0.7)";
        ctx.beginPath(); ctx.arc(a.x, a.y, 1.6, 0, 7); ctx.fill();
      });
    }
    function run() {
      if (running) return;
      running = true;
      (function frame() {
        var left = until - performance.now();
        if (left <= 0) { running = false; return; }
        draw(Math.min(left / 800, 1));
        requestAnimationFrame(frame);
      })();
    }
    size();
    draw(0);
    new ResizeObserver(function () { size(); draw(0); }).observe(hero);
    if (!calm) {
      until = performance.now() + 4000;
      run();
      hero.addEventListener("pointermove", function (e) {
        var r = hero.getBoundingClientRect();
        ptr = { x: e.clientX - r.left, y: e.clientY - r.top };
        until = performance.now() + 900;
        run();
      });
      hero.addEventListener("pointerleave", function () { ptr = null; until = performance.now() + 400; run(); });
    }

    // A click on an app shows that it is opening, since some take seconds to answer.
    // A new-tab click leaves this page in place, so it gets no animation.
    var launched = null, timer;
    function stopLaunch() {
      clearTimeout(timer);
      if (launched) launched.classList.remove("is-launching");
      launched = null;
    }
    document.addEventListener("click", function (e) {
      var tile = e.target.closest && e.target.closest("a.apps-tile");
      if (!tile || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      stopLaunch();
      launched = tile;
      tile.classList.add("is-launching");
      document.querySelector("[data-apps-status]").textContent = "Opening " + tile.querySelector(".apps-label").textContent;
      timer = setTimeout(stopLaunch, 15000);
    });
    // Coming back with the browser's Back button restores the page as it was left.
    addEventListener("pageshow", stopLaunch);
  })();
</script>
