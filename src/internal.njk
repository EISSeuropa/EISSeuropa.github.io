---
layout: base.njk
permalink: /internal.html
title: Internal Dashboard
description: Shortcuts to the apps EISS staff, board members and volunteers use. Every app asks for sign-in.
navKey: ""
lang: en
noindex: true
searchExclude: true
eleventyExcludeFromCollections: true
---
{#
  internal.njk: the apps dashboard for staff, board members and volunteers,
  after Google Workspace's "Your apps" page. internal.eiss-europa.com
  redirects here from a separate one-file repo (GitHub Pages serves one
  custom domain per repo).

  Reads: site.staffLinks (entries with `roles`), labels t.staffMenu.<key> or
  the entry's own `label`, site.guideLinks, systemHealth and dashboard (release,
  counts, dates, deadlines, phase).
  The role filter is CSS `:has()` on data-roles, so it works without JS. So does
  the page, with every tab's section stacked.
  A shortcut list, not access control. Everything works without JS: the script
  only adds the first-visit prompt, greeting, clock, live day counts, app count,
  remembered role, Today line, live GitHub figures, card spotlight and the hero
  constellation. Without it the strip shows the figures of the last build.
  #admin: an unlisted view (site.adminLinks) shown by CSS `:target`. Hidden
  from view, not secret: the links are in the source of this public page.

  ponytail: EN only. Its readers work in English. Add .fr/.de siblings when
  someone asks for them, hand-translated (CLAUDE.md §1).
#}
{% from "icons.njk" import icon %}
{%- set t = i18n[lang or "en"] -%}

{# Opens the connection to Indico ahead of the click. #}
<link rel="preconnect" href="https://indico.eiss-europa.com">
<div class="apps-page">
  <p class="sr-only" role="status" data-apps-status></p>
  <header class="apps-hero" data-apps-hero>
    <canvas class="apps-hero-canvas" aria-hidden="true"></canvas>
    <div class="container apps-hero-inner">
      <div class="apps-hero-logo">{% inlineSvg "assets/images/brand/eiss-10-lockup.svg" %}</div>
      <h1 class="apps-hero-title">{{ t.staffMenu.heading }}</h1>
      <p class="apps-hero-clock" data-apps-clock hidden></p>
      <p class="apps-hero-lead">Shortcuts to the apps EISS uses. Each one asks you to sign in, with your eiss-europa.com account for the Google apps.</p>
    </div>
  </header>

  <div class="container">
    {# The welcome: on a first visit, asks the role, then walks through that
       role's joining steps one at a time. Reopened from Guides. Without JS
       it never opens and the Joining Guide covers the same ground.
       ponytail: steps, not a saved checklist. Add per-step ticks if
       people ask to resume where they stopped. #}
    <dialog class="apps-welcome" data-apps-welcome aria-labelledby="apps-welcome-title">
      <button type="button" class="apps-welcome-close" data-apps-welcome-close aria-label="Close the welcome">&times;</button>
      <div data-apps-welcome-role>
        <h2 class="apps-welcome-title" id="apps-welcome-title">Welcome to EISS</h2>
        <p class="apps-welcome-lead">Which describes you? You get the steps for your role, one at a time.</p>
        <div class="apps-welcome-choices">
          <button type="button" class="btn btn-secondary" data-apps-choose="staff" autofocus>Staff</button>
          <button type="button" class="btn btn-secondary" data-apps-choose="management">Management</button>
          <button type="button" class="btn btn-secondary" data-apps-choose="board">Board member</button>
          <button type="button" class="btn btn-secondary" data-apps-choose="volunteer">Volunteer</button>
        </div>
        <button type="button" class="apps-welcome-skip" data-apps-welcome-close>Skip for now</button>
      </div>
      <div data-apps-welcome-steps hidden>
        <p class="apps-welcome-meta" data-apps-welcome-meta aria-live="polite"></p>
        <progress class="apps-progress" data-apps-welcome-bar value="0" max="1" aria-hidden="true"></progress>
        <ol class="apps-welcome-list" role="list">
          {% for stage in dashboard.onboarding %}{% for s in stage.steps %}
            <li class="apps-welcome-step{% if s.key %} apps-welcome-key{% endif %}" data-roles="{{ s.roles | join(' ') }}" data-stage="{{ stage.stage }}">
              {% if s.key %}<p class="apps-welcome-badge">{{ icon("lightbulb") }} {{ s.key }}</p>{% endif %}
              <h3 class="apps-welcome-heading" tabindex="-1">{{ s.title }}</h3>
              {% if s.text %}<p>{{ s.text }}</p>{% endif %}
              {% if s.moving %}<p class="apps-welcome-moving"><strong>Already with EISS?</strong> {{ s.moving }}</p>{% endif %}
              {% if s.links.length %}
                <ul class="apps-welcome-links" role="list">
                  {% for l in s.links %}
                    <li{% if l.roles %} data-roles="{{ l.roles | join(' ') }}"{% endif %}><a class="btn btn-secondary btn-sm" href="{{ l.href }}" target="_blank" rel="noopener">{{ icon(l.icon) }} {{ l.label or t.staffMenu[l.key] }}</a></li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}{% endfor %}
        </ol>
        <div class="apps-welcome-nav">
          <button type="button" class="btn btn-secondary" data-apps-welcome-back>Back</button>
          <button type="button" class="btn btn-primary" data-apps-welcome-next>Next</button>
        </div>
      </div>
    </dialog>

    <dl class="apps-stats">
      {% set deadline = dashboard.deadlines[0] %}
      {% if deadline %}
        <div class="apps-stat" data-apps-deadline>
          <dt data-apps-deadline-label>{{ deadline.label }}</dt>
          <dd><a href="#status" data-apps-deadline-days>{{ deadline.date | daysUntil }} days</a></dd>
        </div>
      {% endif %}
      {% if facts.conferences.next %}
        <div class="apps-stat">
          <dt>days until ESSC {{ facts.conferences.next.startDate | truncate(4, true, "") }}, {{ facts.conferences.next.city }}</dt>
          <dd><a href="/{{ facts.conferences.next.startDate | truncate(4, true, "") }}.html" data-apps-countdown="{{ facts.conferences.next.startDate }}" data-apps-count>{{ facts.conferences.next.startDate | daysUntil }}</a></dd>
        </div>
      {% endif %}
      {% if systemHealth %}
        <div class="apps-stat{% if systemHealth.summary.url %} apps-stat-{{ systemHealth.summary.level }}{% endif %}" data-apps-systems>
          <dt>Systems</dt>
          <dd class="apps-stat-level"><span class="apps-dot apps-dot-{{ systemHealth.summary.level }}" data-apps-systems-dot aria-hidden="true"></span>{% if systemHealth.summary.url %}<a href="{{ systemHealth.summary.url }}" data-apps-systems-label>{{ systemHealth.summary.label }}</a>{% else %}<a data-apps-systems-label>{{ systemHealth.summary.label }}</a>{% endif %}</dd>
        </div>
      {% endif %}
      {% if dashboard.release %}
        <div class="apps-stat">
          <dt>{{ dashboard.release.title }}{% if dashboard.release.due %}, due {{ dashboard.release.due | newsDate("en") }}{% endif %}</dt>
          <dd><a href="{{ dashboard.release.url }}" data-apps-release-percent>{{ dashboard.release.percent }}%</a></dd>
        </div>
      {% endif %}
      {% if dashboard.counts %}
        <div class="apps-stat">
          <dt>tasks to pick up</dt>
          <dd><a href="{{ dashboard.counts[2].url }}" data-apps-live="tasks">{{ dashboard.counts[2].value }}</a></dd>
        </div>
      {% endif %}
    </dl>
    <p class="apps-live" data-apps-asof>{% if systemHealth %}Figures as of {{ systemHealth.checked | newsDate("en") }}{% endif %}</p>
    <div class="apps-today" data-apps-today hidden>
      <div class="apps-today-clip">
        <div class="apps-today-box">
          <p class="apps-today-text" data-apps-today-text hidden></p>
          <p class="apps-done-heading" id="apps-done-heading" data-apps-done-heading hidden></p>
          <div class="apps-done-stage" data-apps-done-stage hidden>
            <ul class="apps-done" data-apps-done role="list" aria-labelledby="apps-done-heading"></ul>
            <button type="button" class="apps-done-pause" data-apps-done-pause aria-pressed="false" aria-label="Pause the closed issues" hidden><span class="apps-done-hold">{{ icon("pause") }}</span><span class="apps-done-play">{{ icon("play") }}</span></button>
          </div>
        </div>
      </div>
    </div>

    {% if dashboard.phase %}
      <section class="apps-phase" aria-labelledby="apps-phase-title">
        <div>
          <h2 class="apps-phase-title" id="apps-phase-title">Now: {{ dashboard.phase.label }}</h2>
          <p class="apps-note">{{ dashboard.phase.note }}</p>
        </div>
        <ul class="apps-phase-links" role="list">
          {% for l in dashboard.phase.links %}
            <li data-roles="{{ l.roles | join(' ') }}"><a class="btn btn-secondary btn-sm" href="{{ l.href }}">{{ icon(l.icon) }} {{ l.label or t.staffMenu[l.key] }}</a></li>
          {% endfor %}
        </ul>
        <ol class="apps-steps" aria-label="Stages of the conference year" style="--apps-steps-n: {{ dashboard.phase.steps.length }}; --apps-steps-fill: {{ dashboard.phase.fill }}">
          {% for s in dashboard.phase.steps %}
            <li class="apps-step apps-step-{{ s.state }}"{% if s.state == "now" %} aria-current="step"{% endif %}><span class="apps-step-dot" aria-hidden="true"></span><span class="apps-step-label">{{ s.step }}{% if s.state == "done" %}<span class="sr-only">, done</span>{% endif %}</span></li>
          {% endfor %}
        </ol>
      </section>
    {% endif %}

    <div class="apps-admin" id="admin">
      <h2 class="apps-heading">Admin</h2>
      <ul class="apps-grid" role="list">
        {% for app in site.adminLinks %}
          <li class="apps-card-wrap" style="--n: {{ loop.index0 }}">
            <a class="apps-tile" href="{{ app.href }}">
              <span class="apps-icon">{{ icon(app.icon) }}</span>
              <span class="apps-label">{{ app.label }}</span>
              <span class="apps-go">{{ icon("arrow-right") }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>

    <div class="apps-tabbar">
      <div class="apps-tabs" role="tablist" aria-label="Dashboard sections" data-apps-tabs hidden>
        <button type="button" role="tab" id="apps-tab-apps" aria-controls="apps" data-apps-tab="apps">Apps</button>
        <button type="button" role="tab" id="apps-tab-status" aria-controls="status" data-apps-tab="status">Project status</button>
        <button type="button" role="tab" id="apps-tab-guides" aria-controls="guides" data-apps-tab="guides">Guides</button>
        {% if systemHealth %}<button type="button" role="tab" id="apps-tab-it" aria-controls="it" data-apps-tab="it" data-roles="staff">IT monitoring <span class="apps-dot apps-dot-{{ systemHealth.summary.level }}" data-apps-it-dot aria-hidden="true"{% if not systemHealth.summary.url %} hidden{% endif %}></span><span class="sr-only" data-apps-it-note{% if not systemHealth.summary.url %} hidden{% endif %}>, needs attention</span></button>{% endif %}
      </div>
      <div class="apps-viewing">
        <label for="apps-role">Viewing as</label>
        <select class="apps-role" id="apps-role">
          <option value="all" selected>Show all</option>
          <option value="staff">Staff</option>
          <option value="management">Management</option>
          <option value="board">Board member</option>
          <option value="volunteer">Volunteer</option>
        </select>
      </div>
    </div>

    <section class="apps-panel" id="apps" data-apps-panel aria-labelledby="apps-heading">
      <div class="apps-panel-head">
        <div>
          <h2 class="apps-heading" id="apps-heading">Your apps</h2>
          <p class="apps-count" data-apps-total role="status" hidden></p>
        </div>
        <div class="apps-filter" data-apps-filter-box hidden>
          <label class="sr-only" for="apps-filter">Filter apps</label>
          <input class="apps-filter-input" id="apps-filter" type="search" placeholder="Filter apps" autocomplete="off" spellcheck="false" data-apps-filter>
        </div>
      </div>

      <ul class="apps-grid" role="list">
        {% set n = 0 %}
        {% for app in site.staffLinks %}{% if app.roles %}
          {% set note = app.note or t.staffMenu[app.key + "Note"] %}
          <li class="apps-card-wrap"{% if app.href %} data-apps-app{% endif %} data-roles="{{ app.roles | join(' ') }}" style="--n: {{ n }}">
            {% if app.href %}
              <a class="apps-tile" href="{{ app.href }}">
                <span class="apps-icon">{{ icon(app.icon) }}{% if app.badge %}<span class="apps-badge">{{ app.badge }}</span>{% endif %}</span>
                <span class="apps-label">{{ app.label or t.staffMenu[app.key] }}</span>
                {% if note %}<span class="apps-note">{{ note }}</span>{% endif %}
                <span class="apps-go">{{ icon("arrow-right") }}</span>
              </a>
            {% else %}
              <div class="apps-tile apps-tile-soon">
                <span class="apps-icon">{{ icon(app.icon) }}</span>
                <span class="apps-label">{{ app.label }}</span>
                {% if note %}<span class="apps-note">{{ note }}</span>{% endif %}
              </div>
            {% endif %}
          </li>
          {% set n = n + 1 %}
        {% endif %}{% endfor %}
      </ul>
      <p class="apps-note apps-filter-empty" data-apps-filter-empty hidden></p>
    </section>

    <section class="apps-panel" id="status" data-apps-panel aria-labelledby="apps-status-heading">
      <h2 class="apps-heading apps-section-heading" id="apps-status-heading">Project status</h2>
      <div class="apps-status">
        {% if dashboard.release %}
          <div class="apps-status-card" data-roles="staff">
            <h3 class="apps-status-title">Next release</h3>
            <p class="apps-release"><a href="{{ dashboard.release.url }}">{{ dashboard.release.title }}</a>{% if dashboard.release.due %}, due {{ dashboard.release.due | newsDate("en") }}{% endif %}</p>
            <div class="apps-progress-wrap">
              <progress class="apps-progress" data-apps-release-bar value="{{ dashboard.release.closed }}" max="{{ dashboard.release.total }}" aria-label="{{ dashboard.release.title }} progress">{{ dashboard.release.percent }}%</progress><span class="apps-progress-new" data-apps-release-new hidden></span></div>
            <p class="apps-note" data-apps-release-note>{{ dashboard.release.closed }} of {{ dashboard.release.total }} issues closed</p>
            <div class="apps-pace" data-apps-pace hidden>
              <p class="apps-pace-summary" data-apps-pace-summary></p>
              <div class="apps-pace-plot">
                <div class="apps-pace-bars" data-apps-pace-bars aria-hidden="true"></div>
                <p class="apps-pace-tip" data-apps-pace-tip hidden></p>
              </div>
              <p class="apps-pace-axis" aria-hidden="true"><span>30 days ago</span><span>Today</span></p>
              <details class="apps-pace-table">
                <summary>Days with closures</summary>
                <table>
                  <thead><tr><th scope="col">Day</th><th scope="col">Issues closed</th></tr></thead>
                  <tbody data-apps-pace-rows></tbody>
                </table>
              </details>
            </div>
          </div>
        {% endif %}
        {% if dashboard.counts %}
          <div class="apps-status-card" data-roles="staff volunteer">
            <h3 class="apps-status-title">On GitHub</h3>
            <ul class="apps-counts" role="list">
              {% for c in dashboard.counts %}
                <li data-roles="{{ c.roles | join(' ') }}"><a href="{{ c.url }}"><strong data-apps-live="{{ ['issues', 'prs', 'tasks'][loop.index0] }}">{{ c.value }}</strong> {{ c.label }}</a></li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
        {% if dashboard.dates.length %}
          <div class="apps-status-card">
            <h3 class="apps-status-title">Key dates</h3>
            <ol class="apps-timeline" data-apps-timeline>
              {% for d in dashboard.dates %}
                {% if d.state == "next" %}<li class="apps-timeline-today" data-apps-timeline-today aria-hidden="true"><span>Today</span></li>{% endif %}
                <li class="apps-timeline-item apps-timeline-{{ d.state }}" data-roles="{{ d.roles | join(' ') }}" data-date="{{ d.date }}"><span class="apps-timeline-dot" aria-hidden="true"></span><time datetime="{{ d.date }}">{{ d.date | newsDate("en") }}</time> <span class="apps-timeline-label">{{ d.label }}</span><span class="apps-timeline-when" data-apps-timeline-when>{% if d.state == "past" %}<span class="sr-only">, done</span>{% endif %}</span></li>
              {% endfor %}
            </ol>
            {% if dashboard.calendar %}<p class="apps-note apps-timeline-more"><a href="{{ dashboard.calendar }}">All deadlines, internal ones included</a></p>{% endif %}
          </div>
        {% endif %}
      </div>
    </section>

    {% if systemHealth %}
      <section class="apps-panel apps-health" id="it" data-apps-panel aria-labelledby="apps-health-heading" data-roles="staff">
        <h2 class="apps-heading apps-section-heading" id="apps-health-heading">IT System Monitoring</h2>
        <div class="apps-status">
          {% for repo in systemHealth.repos %}
            <div class="apps-status-card">
              <h3 class="apps-status-title apps-health-brand">
                <a href="{{ repo.site }}" aria-label="{{ repo.label }}">
                  {% if loop.first %}<span aria-hidden="true">{% inlineSvg "assets/images/brand/logo-lockup.svg" %}</span>{% else %}<img src="/assets/images/partners/netsec.svg#svgView(viewBox(360,780,2800,930))" alt="" width="120" height="40">{% endif %}
                </a>
              </h3>
              <p class="apps-health-level" data-apps-repo-level="{{ repo.slug }}"><span class="apps-dot apps-dot-{{ repo.level }}" aria-hidden="true"></span><span>{{ repo.levelLabel }}</span></p>
              <p class="apps-health-summary" data-apps-repo-summary="{{ repo.slug }}">{% if repo.failedCount %}{{ repo.failedCount }} of {{ repo.items.length }} automations failing{% else %}{{ repo.items.length }} automations, none failing{% endif %}</p>
              <details class="apps-health-details" data-apps-repo-details="{{ repo.slug }}"{% if repo.failedCount %} open{% endif %}>
                <summary>Every automation</summary>
                <ul class="apps-health-list" role="list">
                  {% for item in repo.items %}
                    <li class="apps-health-item{% if item.failed %} apps-health-failed{% endif %}" data-apps-run="{{ repo.slug }}|{{ item.name }}"><span class="apps-dot apps-dot-{{ item.level }}" aria-hidden="true"></span><div><a href="{{ item.url }}">{{ item.name }}</a> <span>{{ item.label }}{% if item.date %}, {{ item.date | newsDate("en") }}{% endif %}</span></div></li>
                  {% endfor %}
                </ul>
              </details>
            </div>
          {% endfor %}
          <div class="apps-status-card">
            <h3 class="apps-status-title">Google Workspace</h3>
            <p class="apps-health-level"><span class="apps-dot apps-dot-{{ systemHealth.workspace.level }}" aria-hidden="true"></span>{{ systemHealth.workspace.levelLabel }}</p>
            <ul class="apps-health-list" role="list">
              {% if systemHealth.google %}
                <li class="apps-health-item"><span class="apps-dot apps-dot-{{ systemHealth.google.level }}" aria-hidden="true"></span><div><a href="https://www.google.com/appsstatus/dashboard/">Google's services</a> <span>{{ systemHealth.google.levelLabel }}{% if systemHealth.google.services.length %}: {{ systemHealth.google.services | join(", ") }}{% endif %}</span></div></li>
              {% else %}
                <li><a href="https://www.google.com/appsstatus/dashboard/">Google's services</a> <span>Could not be read at the last build</span></li>
              {% endif %}
              {% if systemHealth.workspace.checks %}
                {% for check in systemHealth.workspace.checks %}
                  <li class="apps-health-item"><span class="apps-dot apps-dot-{{ check.level }}" aria-hidden="true"></span><div><a href="https://script.google.com/home/executions">{{ check.name }}</a> <span>{{ check.label }}{% if check.date %}, last good run {{ check.date | newsDate("en") }}{% endif %}</span></div></li>
                {% endfor %}
              {% else %}
                <li><a href="https://script.google.com/home/executions">Apps Script runs</a> <span>Could not be read at the last build</span></li>
              {% endif %}
              <li><a href="https://admin.google.com/ac/ac">Security alerts</a> <span>Not monitored here</span></li>
            </ul>
          </div>
        </div>
        <p class="apps-note" data-apps-asof>Figures as of {{ systemHealth.checked | newsDate("en") }}.</p>
      </section>
    {% endif %}

    <section class="apps-panel" id="guides" data-apps-panel aria-labelledby="apps-guides-heading">
      <h2 class="apps-heading apps-section-heading" id="apps-guides-heading">Guides</h2>
      <ul class="apps-grid" role="list">
        {% for guide in site.guideLinks %}
          <li class="apps-card-wrap" data-roles="{{ guide.roles | join(' ') }}" style="--n: {{ loop.index0 }}">
            <a class="apps-tile apps-tile-short" href="{{ guide.href }}">
              <span class="apps-icon">{{ icon(guide.icon) }}</span>
              <span class="apps-label">{{ guide.label }}</span>
              <span class="apps-go">{{ icon("arrow-right") }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </section>
  </div>
</div>

<script type="application/json" id="apps-data">{{ { deadlines: dashboard.deadlines, release: dashboard.release, counts: dashboard.counts, repo: dashboard.repo, health: systemHealth } | dump | safe }}</script>
<script>
  (function () {
    var calm = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Remember the role choice and report how many apps it leaves. The
    // filtering itself is CSS.
    var KEY = "eiss-apps-role";
    var roleSelect = document.getElementById("apps-role");
    var total = document.querySelector("[data-apps-total]");
    var saved = null;
    try { saved = localStorage.getItem(KEY); } catch (e) {}
    function tally() {
      var shown = [].filter.call(document.querySelectorAll("[data-apps-app]"), function (el) {
        return getComputedStyle(el).display !== "none";
      }).length;
      total.textContent = shown + (shown === 1 ? " app" : " apps");
      total.hidden = false;
    }
    if (saved && roleSelect.querySelector('[value="' + CSS.escape(saved) + '"]')) roleSelect.value = saved;
    roleSelect.addEventListener("change", function () {
      try { localStorage.setItem(KEY, roleSelect.value); } catch (e) {}
      tally();
      renderToday();
      renderTimeline(false);
      keepTabVisible();
    });
    tally();

    // The welcome dialog. It opens once per device, on a first visit with no
    // role saved, and from any link to #welcome. Choosing a role sets the
    // role menu, which also filters the steps' links.
    var WELCOMED = "eiss-apps-welcomed";
    var dlg = document.querySelector("[data-apps-welcome]");
    var roleBox = dlg.querySelector("[data-apps-welcome-role]");
    var stepBox = dlg.querySelector("[data-apps-welcome-steps]");
    var allSteps = [].slice.call(dlg.querySelectorAll(".apps-welcome-step"));
    var wMeta = dlg.querySelector("[data-apps-welcome-meta]");
    var wBar = dlg.querySelector("[data-apps-welcome-bar]");
    var wBack = dlg.querySelector("[data-apps-welcome-back]");
    var wNext = dlg.querySelector("[data-apps-welcome-next]");
    var wSteps = [], wAt = 0;
    function openWelcome() {
      roleBox.hidden = false;
      stepBox.hidden = true;
      if (!dlg.open) dlg.showModal();
    }
    function wShow(i) {
      wAt = i;
      allSteps.forEach(function (li) { li.classList.toggle("is-on", li === wSteps[i]); });
      wMeta.textContent = wSteps[i].getAttribute("data-stage") + ": step " + (i + 1) + " of " + wSteps.length;
      wBar.max = wSteps.length;
      wBar.value = i + 1;
      wBack.hidden = i === 0;
      wNext.textContent = i === wSteps.length - 1 ? "Finish" : "Next";
      wSteps[i].querySelector(".apps-welcome-heading").focus();
    }
    dlg.addEventListener("click", function (e) {
      var t = e.target.closest("button");
      if (!t) return;
      var role = t.getAttribute("data-apps-choose");
      if (role) {
        roleSelect.value = role;
        roleSelect.dispatchEvent(new Event("change"));
        wSteps = allSteps.filter(function (li) { return li.getAttribute("data-roles").split(" ").indexOf(role) >= 0; });
        roleBox.hidden = true;
        stepBox.hidden = false;
        wShow(0);
      } else if (t.hasAttribute("data-apps-welcome-close")) dlg.close();
      else if (t === wBack) wShow(wAt - 1);
      else if (t === wNext) { if (wAt < wSteps.length - 1) wShow(wAt + 1); else dlg.close(); }
    });
    dlg.addEventListener("close", function () {
      try { localStorage.setItem(WELCOMED, "1"); } catch (e) {}
      // Opened on load, the dialog has no earlier focus to return to.
