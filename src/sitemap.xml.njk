---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{#- The machine-readable sitemap, for crawlers. The human-readable one is the
    hand-curated /sitemap.html, which carries a single line for the whole
    Anthology and is deliberately NOT generated from this list: 315 paper URLs
    are what a crawler wants and the last thing a reader wants (#1293).

    <lastmod> comes from the corpus ledger and is emitted only for pages that
    have a trustworthy date. Build time would be a lie that changes on every
    scheduled rebuild, so pages without a real date omit the element, which the
    protocol allows per URL. -#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for entry in collections.all -%}
  {%- if not entry.data.redirectTo and entry.url != "/sitemap.xml" %}
  {#- Papers take the corpus ledger's date, everything else its source file's
      last commit. The ledger is the better signal where it exists: it records
      when the paper or its abstract actually landed, whereas a git date would
      track edits to the data module that happens to contain it. -#}
  {%- set lastmod = sitemapDates[entry.url] or (entry.page.inputPath | gitLastmod) %}
  <url><loc>{{ site.url }}{{ entry.url }}</loc>{% if lastmod %}<lastmod>{{ lastmod }}</lastmod>{% endif %}</url>
  {%- endif -%}
{%- endfor %}
</urlset>
