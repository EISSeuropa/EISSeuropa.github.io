---
layout: base.njk
lang: en
---
{# One blog post (#1259). Front matter and the shared defaults come from
   src/blog/blog.11tydata.js, so a post is one Markdown file.

   The byline is a name and a line, not a profile link: authors here are
   volunteers and interns with no board.json entry, and building an author-page
   system for a byline would be the wrong size of solution. #}
{% from "icons.njk" import icon %}
{%- set bt = i18n[lang or "en"] -%}
{%- set blogHref = "/blog.html" | localizedHref(lang) -%}

<header class="page-header">
  <div class="container">
    <span class="eyebrow"><a href="{{ blogHref }}">{{ bt.nav.blog }}</a></span>
    <h1>{{ title }}</h1>
    <p class="blog-byline">
      {{ bt.blogPost.by }} {{ author }}{% if authorNote %}, {{ authorNote }}{% endif %}.
      <time datetime="{{ page.date.toISOString().slice(0, 10) }}">{{ page.date.toISOString() | newsDate(lang) }}</time>
    </p>
  </div>
</header>

<section class="section">
  <div class="container">
    <div class="prose">
      {{ content | safe }}
    </div>

    <p class="blog-back">
      <a href="{{ blogHref }}">{{ icon("arrow-left") }} {{ bt.blogPost.allPosts }}</a>
    </p>
  </div>
</section>
