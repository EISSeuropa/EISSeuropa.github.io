---
pagination:
  # Themes across locales (#1495): atlasThemeLocales is atlasThemePages
  # multiplied by en/fr/de, so the seventeen theme views exist in all three
  # languages from one template rather than three.
  data: atlasThemeLocales
  size: 1
  alias: atlasTheme
  # Eleventy adds only a paginated template's FIRST page to collections.all
  # unless asked otherwise, and collections.all is what sitemap.xml.njk walks.
  # Without this, sixteen of the seventeen theme pages would be absent from the
  # sitemap, which defeats the point: these pages exist so a crawler can see a
  # filtered view of the Atlas (#1255). The same default is why 314 of the 315
  # paper pages are missing from the sitemap today, tracked separately.
  addAllPagesToCollections: true
layout: base.njk
permalink: "/anthology-atlas/theme/{{ atlasTheme.slug }}{{ atlasTheme.suffix }}.html"
navKey: "navigator"
# Corpus citation metadata (#1490): the fields the Anthology emits, under this
# theme's own title.
corpusMeta: true
eleventyComputed:
  lang: "{{ atlasTheme.lang }}"
  # The beta-translation ribbon on the FR/DE views, and nothing on the English
  # ones. Same reasoning as the canonical pages: the translation is by hand and
  # unreviewed, so it says so (CLAUDE.md §1).
  status: "{{ 'beta' if atlasTheme.lang != 'en' else '' }}"
  corpusMetaTitle: "The European Security Studies Anthology Atlas: {{ atlasTheme.name }}"
  # `safe` because these are our own catalog strings: without it Nunjucks
  # escapes the apostrophe in "Atlas de l'Anthologie" here and base.njk
  # escapes the ampersand again, so the tab reads "l&amp;#39;Anthologie".
  title: "{{ i18n[atlasTheme.lang].atlas.themeTitle | replace('{name}', atlasTheme.label[atlasTheme.lang] or atlasTheme.label.en) | safe }}"
  description: "{{ i18n[atlasTheme.lang].atlas.themeDescription | replace('{count}', atlasTheme.count) | replace('{lower}', (atlasTheme.label[atlasTheme.lang] or atlasTheme.label.en) | lower) | replace('{range}', (atlasTheme.firstYear ~ ' ' ~ i18n[atlasTheme.lang].atlas.yearRangeJoiner ~ ' ' ~ atlasTheme.lastYear) if atlasTheme.firstYear != atlasTheme.lastYear else atlasTheme.firstYear) | safe }}"
  metaImage: "/assets/images/atlas-theme-{{ atlasTheme.slug }}-meta.jpg"
  alternates:
    en: "/anthology-atlas/theme/{{ atlasTheme.slug }}.html"
    fr: "/anthology-atlas/theme/{{ atlasTheme.slug }}.fr.html"
    de: "/anthology-atlas/theme/{{ atlasTheme.slug }}.de.html"
# CC BY 4.0 content + corpus, declared in the head and in the body (#1488).
ccbyLicence: true
---
{# One page per research theme (#1255). A query string cannot carry Open Graph
   tags, so a shared ?themes= link produced the generic Atlas card and the one
   thing making the link interesting was invisible to a crawler. These are real
   URLs with their own title, description and card.

   The body is the same include the canonical /anthology-atlas.html uses; the
   `atlasTheme` alias above is what switches it into pre-filtered mode.

   data-pagefind-ignore: these are 17 near-identical pages by body content, and
   #1255 asks that they not flood site search. They stay in the sitemap, because
   the whole point is that a crawler can see them. Self-canonical for the same
   reason: they are genuinely distinct views, not duplicates of the bare Atlas. #}
<div data-pagefind-ignore>
  {% include "atlas-body.njk" %}
</div>
