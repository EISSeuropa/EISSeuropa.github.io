---
layout: base.njk
permalink: /index.de.html
title: false
homeTitle: Europäische Initiative für Sicherheitsstudien (EISS)
description: Wir sind die größte und vielfältigste europäische Versammlung von Wissenschaftlern und Praktikern zu Sicherheitsfragen.
metaImage: /assets/images/index-meta.jpg
navKey: home
lang: de
status: beta
alternates:
  en: /
  fr: /index.fr.html
  de: /index.de.html
---
{% from "icons.njk" import icon %}

<section class="hero" aria-labelledby="hero-title">
  {%- set heroImg = conferences.heroEdition.heroImage if conferences.heroEdition %}
  {%- if heroImg %}
  <div class="hero-bg" aria-hidden="true">
    <img src="{{ heroImg }}-1600x900.jpg"
         srcset="{{ heroImg }}-480x270.jpg 480w,
                 {{ heroImg }}-800x450.jpg 800w,
                 {{ heroImg }}-1600x900.jpg 1600w"
         sizes="100vw"
         alt=""
         loading="eager"
         fetchpriority="high"
         width="1600" height="900">
  </div>
  {%- endif %}
  <div class="container hero-inner">
    <h1 id="hero-title" class="reveal">Die Europäische Initiative für Sicherheitsstudien</h1>
    <p class="hero-tagline reveal reveal-delay-1">
      Die größte und vielfältigste europäische Versammlung von Wissenschaftlern und Praktikern zu Sicherheitsfragen.
    </p>
    <div class="hero-actions reveal reveal-delay-2">
      {%- if conferences.next %}
      <a class="btn btn-primary" href="/{{ conferences.next.slug }}.de.html">ESSC {{ conferences.next.year }} entdecken {{ icon("arrow-right") }}</a>
      {%- else %}
      {# Between editions there is no conference page to point at yet, so the
         newsletter (where the next one is announced first) takes the slot. #}
      <a class="btn btn-primary" href="{{ site.newsletterUrl }}" target="_blank" rel="noopener">{{ icon("bell") }} Newsletter abonnieren</a>
      {%- endif %}
      <a class="btn btn-ghost" href="/initiative.de.html">Über die Initiative</a>
    </div>
    <p class="hero-links reveal reveal-delay-3">
      {%- if conferences.next %}
      <a href="{{ site.newsletterUrl }}" target="_blank" rel="noopener">{{ icon("bell", "icon-inline") }}Newsletter abonnieren</a>
      {%- endif %}
      <a href="{{ site.social.youtube }}" target="_blank" rel="noopener">{{ icon("youtube", "icon-inline") }}Unserem YouTube-Kanal folgen</a>
      <a href="mailto:{{ site.contactEmail }}">{{ icon("mail", "icon-inline") }}Kontakt</a>
    </p>
  </div>
</section>

{% include "home-stats.njk" %}

{% include "home-pillars.njk" %}

{% set conf = conferences.next %}
{% if conf %}
<section class="section" aria-labelledby="featured-title">
  <div class="container">
    <article class="card featured">
      <div>
        <div class="featured-eyebrow">Nächste Konferenz</div>
        <h2 id="featured-title">European Security Studies Conference {{ conf.year }}</h2>
        {% set year = conf.year %}
        {% include "countdown.njk" %}
        <p class="featured-orgs">
          {{ conf.organisers.de }}
        </p>
        <div class="featured-meta">
          <div>
            <strong>{{ icon("calendar", "icon-inline") }}Datum</strong>
            {{ conf.dates.de }}
          </div>
          <div>
            <strong>{{ icon("map-pin", "icon-inline") }}Ort</strong>
            {{ conf.venue.de }}
          </div>
        </div>
        <div class="featured-registration">
          {%- set hideBadgeCta = conf.livestreamUrl and conf.endDate >= conferences.today -%}
          {% include "registration-badge.njk" %}
          {%- if conf.livestreamUrl and conf.endDate >= conferences.today %}
          <a class="programme-live-tag" href="{{ conf.livestreamUrl }}" target="_blank" rel="noopener">{{ icon("video") }} Livestream {{ icon("external-link") }}</a>
          {%- endif %}
        </div>
        <div>
          <a class="btn btn-primary" href="/{{ conf.slug }}.de.html">Mehr über die ESSC&nbsp;{{ conf.year }} erfahren {{ icon("arrow-right") }}</a>
        </div>
      </div>
      <aside class="featured-date" aria-hidden="true">
        <div class="month">{{ conf.monthLabel.de }}</div>
        <div class="day">{{ conf.dayRange | replace("–", "<span aria-hidden='true'>–</span>") | safe }}</div>
        <div class="year">{{ conf.year }} · {{ conf.city }}</div>
      </aside>
    </article>
  </div>
</section>
{% endif %}

{% set limit = 5 %}
{% include "indico-events-list.njk" %}

{% include "announcement-card.njk" %}

{% include "news-latest.njk" %}

{% include "home-film.njk" %}

{% include "home-map.njk" %}

{% include "home-paper.njk" %}

{% set promoHideStats = true %}
{% include "navigator-promo.njk" %}

{% include "home-join.njk" %}
