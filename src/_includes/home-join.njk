{# Homepage join band: one accent band holding the membership offer (tiers
   with their fees, the latest members' event, the join and manage buttons)
   beside the newsletter. While a conference is next the heading points at
   its city (homeJoin.seeYouIn). A locale without that string, or no next
   conference, falls back to homeJoin.heading. The newsletter button opens
   Mailchimp's own sign-up page, so this site collects no addresses (see
   /policy). Fees come from site.membershipPrices, which /membership reads
   too. #}
{% from "icons.njk" import icon %}
{%- set _lang = lang or "en" -%}
{%- set t = i18n[_lang] -%}
{%- set hj = t.homeJoin -%}
{%- set ev = pastEvents[0] -%}
{%- set _next = conferences.next -%}
{%- if _next and hj.seeYouIn -%}
  {%- set _heading = hj.seeYouIn | replace("{city}", (_next.cityLabel and _next.cityLabel[_lang]) or _next.city) -%}
{%- else -%}
  {%- set _heading = hj.heading -%}
{%- endif -%}
<section class="section" aria-labelledby="join-title">
  <div class="container">
    <div class="home-join">
      <div class="home-join__member">
        <h2 id="join-title" class="home-join__title">{{ _heading }}</h2>
        <p class="home-join__lead">{{ hj.ticketLine }}</p>
        <ul class="home-join__tiers" role="list">
          {%- for key in ["student", "early", "established"] %}
          <li>{{ t.membership.tiers[key] }} <strong>{{ t.membership.perYear | replace("{n}", site.membershipPrices[key]) }}</strong></li>
          {%- endfor %}
        </ul>
        {%- if ev %}
        <p class="home-join__event">
          <span class="home-join__eyebrow">{{ t.pastEvents.sectionHeading }}</span>
          <a href="{{ ev.href }}" target="_blank" rel="noopener" lang="en">{{ ev.title }}</a>
          · <time datetime="{{ ev.date }}">{{ ev.date | newsDate(_lang) }}</time>
        </p>
        {%- endif %}
        <div class="home-join__actions">
          <a class="btn btn-primary" href="{{ '/membership.html' | localizedHref(_lang) }}#become-a-member">{{ icon("user-plus") }} {{ hj.become }}</a>
          <a class="btn btn-secondary" href="{{ site.membershipPortalUrl }}" target="_blank" rel="noopener">{{ hj.manage }} {{ icon("external-link") }}</a>
        </div>
      </div>
      <div class="home-join__news">
        <h2 class="home-join__news-title">{{ t.nav.newsletter }}</h2>
        <a class="btn btn-primary" href="{{ site.newsletterUrl }}" target="_blank" rel="noopener">{{ icon("bell") }} {{ hj.subscribe }} {{ icon("external-link") }}</a>
        <a class="home-join__link" href="{{ site.social.youtube }}" target="_blank" rel="noopener">{{ icon("youtube", "icon-inline") }}{{ hj.youtube }}</a>
      </div>
    </div>
  </div>
</section>
