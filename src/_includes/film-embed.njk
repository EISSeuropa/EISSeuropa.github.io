{# Self-hosted portrait conference film in a phone-style frame.

   Set before including:
     filmSrc     — MP4 URL, served same-origin from /assets/video/ so the
                   host sends Content-Type: video/mp4 and inline plays on
                   iOS (GitHub Release assets are application/octet-stream
                   + attachment, which iOS refuses to play inline)
     filmPoster  — poster image path
     filmCaption — already-localised caption line (optional)
   A text description of the film comes from i18n film.desc, keyed by the
   MP4's file name (RGAA 4.1); add one for every new film.

   theme.js sets the src and muted-autoplay-loops it only when it scrolls
   into view (nothing downloads otherwise; pauses off-screen). The film is
   silent — muted, no sound control.

   The centre button is the play/pause control, and it is the one assistive
   technology and the keyboard see. It stays in the accessibility tree while
   the film plays rather than being hidden, because that is exactly when a
   pause control is needed (WCAG 2.2.2); CSS fades it out of the picture and
   hover or focus brings it back. Tapping the film itself toggles too, as a
   pointer convenience. prefers-reduced-motion: native controls, no autoplay. #}
{% from "icons.njk" import icon %}
{%- set _lang = lang or "en" -%}
{%- set t = i18n[_lang] -%}
<figure class="film">
  <div class="film-frame">
    <video class="film-video" playsinline muted loop preload="none"
           poster="{{ filmPoster | bust }}"
           data-film="{{ filmSrc }}"
           aria-label="{{ filmCaption or t.film.play }}"></video>
    <button class="film-play" type="button" data-film-play hidden data-state="paused"
            data-label-play="{{ t.film.play }}" data-label-pause="{{ t.film.pause }}"
            aria-label="{{ t.film.play }}">
      <svg class="film-play-glyph-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
      <svg class="film-play-glyph-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h4v14H6zm8 0h4v14h-4z"/></svg>
    </button>
  </div>
  {#- Text alternative to the picture track (RGAA 4.1, 4.5), keyed by the file
      name in i18n film.desc. A film without an entry shows none. It sits inside
      the figcaption, which must be the figure's first or last child (RGAA 8.2). #}
  {%- set _filmKey = filmSrc | replace("/assets/video/", "") | replace(".mp4", "") %}
  {%- set _filmDesc = t.film.desc and t.film.desc[_filmKey] %}
  {%- if filmCaption or _filmDesc %}
  <figcaption class="film-caption muted">{{ filmCaption }}
    {%- if _filmDesc %}
    <details class="film-desc">
      <summary>{{ t.film.descLabel }}</summary>
      <p>{{ _filmDesc }}</p>
    </details>
    {%- endif %}
  </figcaption>
  {%- endif %}
</figure>
