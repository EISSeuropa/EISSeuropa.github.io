{# Nav consumes `t` (the active-locale chrome catalog) and `lang` from base.njk.
   Nav-item href / key / external flag stay in src/_data/site.js;
   only the visible text label is looked up from `t.nav.<key>`. #}
<header class="site-header">
  <nav class="container nav" aria-label="Primary">
    {# Brand link. The `<a>` carries the accessible name; SVGs inside
       are aria-hidden so screen readers don't double-announce "EISS".
       Two visual variants are inlined and CSS swaps them at the 600 px
       breakpoint — desktop shows the constellation + EiSS wordmark
       lockup, mobile collapses to the iconmark + the localised brand
       label text so the link always carries a name (the lockup SVG's
       EiSS wordmark is decorative, not text).
       Inlining (rather than <img src=...>) lets `currentColor` cascade
       from the header's `--text` token, so the wordmark adapts to
       light/dark while the constellation keeps its literal brand
       light-blue. #}
    <a class="nav-brand" href="{{ '/' if lang == 'en' else '/index.' + lang + '.html' }}" aria-label="EISS — {{ site.fullName }}, home">
      <span class="brand-logo brand-logo--lockup" aria-hidden="true">
        {% inlineSvg "assets/images/brand/logo-lockup.svg" %}
      </span>
      <span class="brand-logo brand-logo--mark" aria-hidden="true">
        {% inlineSvg "assets/images/brand/logo-mark.svg" %}
      </span>
      <span class="nav-brand-label">{{ t.nav.brandLabel }}</span>
    </a>

    {# Two shapes of nav item live in this list. A leaf is a plain
       `.nav-link` anchor. A group (any item with `children` in
       site.nav) is a native `<details>` disclosure: `<summary>` is the
       trigger, the panel is a nested `<ul>`. Native disclosure carries
       the keyboard and screen-reader behaviour for free and stays
       usable with JS off (the groups just sit closed and open on
       click). theme.js adds the niceties on top: closing siblings,
       Escape, outside-click. See #1319. #}
    <ul class="nav-links" id="primary-nav" data-nav-menu>
      {% for item in site.nav %}
        {% if item.key != "home" %}
          {# `localizedHref` returns the `.lang.html` sibling when it
             exists in src/ (Eleventy generates the matching output
             file), and falls back to the English page otherwise.
             External URLs and the home "/" pass through unchanged.
             See .eleventy.js for the full filter contract (#162). #}
          {%- set itemHref = item.href if item.external else (item.href | localizedHref(lang)) -%}
          {%- set sectionCurrent = navKey and (navKey in item.match) -%}
          <li>
            {% if item.children %}
              <details class="nav-group" data-nav-group>
                <summary class="nav-link nav-group-summary"
                         {% if sectionCurrent %}data-section-current="true"{% endif %}>
                  {{ t.nav[item.key] }}
                  <svg class="nav-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </summary>
                <ul class="nav-group-panel">
                  {# The Conference group leads with the editions, built in
                     conferences.js (`navEditions`) so the yearly rollover
                     moves the nav without a data edit here. Between
                     editions there is no upcoming one, and the list is
                     simply the most recent completed conferences. #}
                  {% for edition in conferences.navEditions if item.editions %}
                    <li>
                      <a class="nav-group-link" href="{{ ('/' + edition.slug + '.html') | localizedHref(lang) }}">
                        {{ edition.label[lang] }}
                        {% if edition.isNext %}<span class="nav-group-badge">{{ t.nav.nextEdition }}</span>{% endif %}
                      </a>
                    </li>
                  {% endfor %}
                  {% for child in item.children %}
                    {%- set childHref = child.href if child.external else (child.href | localizedHref(lang)) -%}
                    <li>
                      <a class="nav-group-link"
                         href="{{ childHref }}"
                         {% if child.external %}target="_blank" rel="noopener"{% endif %}
                         {% if child.key == navKey %}aria-current="page"{% endif %}>
                        {{ t.nav[child.key] }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </details>
            {% else %}
              <a class="nav-link"
                 href="{{ itemHref }}"
                 {% if item.external %}target="_blank" rel="noopener"{% endif %}
                 {% if sectionCurrent %}aria-current="page"{% endif %}>
                {{ t.nav[item.key] }}
              </a>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>

    <div class="nav-actions">
      {# Language switcher chips. Always shows all 3; on untranslated
         pages the FR/DE chip falls back to the language homepage
         (the `alternates` lookup handles the difference). #}
      <div class="lang-switcher" role="group" aria-label="{{ t.langSwitcher.label }}">
        {% for L in i18n._order %}
          {%- set href = alternates[L] if alternates and alternates[L] else ('/' if L == 'en' else '/index.' + L + '.html') -%}
          <a class="lang-chip"
             href="{{ href }}"
             hreflang="{{ L }}"
             {% if L == lang %}aria-current="true"{% endif %}
             title="{{ t.langSwitcher[L + 'Title'] }}">{{ t.langSwitcher[L] }}</a>
        {% endfor %}
      </div>

      {# Search trigger. Opens the site-search modal (search-modal.njk).
         Icon-only, so the accessible name comes from aria-label. The
         button is always rendered; on local dev where the Pagefind index
         is absent it opens the modal and shows the "unavailable" notice
         rather than erroring. #}
      <button class="icon-btn"
              type="button"
              data-search-trigger
              aria-label="{{ t.search.buttonLabel }}">
        {% from "icons.njk" import icon %}{{ icon("search") }}
      </button>

      {% include "theme-toggle.njk" %}
      <button class="icon-btn nav-menu-toggle"
              type="button"
              data-menu-toggle
              aria-label="{{ t.nav.brandLabel }} — menu"
              aria-controls="primary-nav"
              aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"/>
          <line x1="4" y1="12" x2="20" y2="12"/>
          <line x1="4" y1="17" x2="20" y2="17"/>
        </svg>
      </button>
    </div>
  </nav>
</header>
