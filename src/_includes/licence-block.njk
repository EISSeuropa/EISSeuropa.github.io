{# Licence block (#1488). The footer used to assert all rights reserved over
   material the same page offers under CC BY 4.0, which is the sentence a
   cautious reader acts on. The footer now separates the site from the corpus,
   and this block states the position where the reader is, rather than making
   them scroll to the bottom to find a contradiction. Rendered on the
   Anthology, the Atlas and the seventeen theme pages. #}
{%- set lb = i18n[lang or "en"].footer.licenceBlock -%}
<aside class="licence-block" aria-labelledby="licence-block-h">
  <img class="licence-block__badge" src="/assets/images/badges/cc-by.svg" width="112" height="20"
       alt="Licence: CC BY 4.0" loading="lazy" decoding="async">
  <div class="licence-block__body">
    <h2 class="licence-block__h" id="licence-block-h">{{ lb.heading }}</h2>
    <p class="licence-block__text">{{ lb.body }}</p>
    <p class="licence-block__text">
      <span class="licence-block__label">{{ lb.attributionLabel }}</span>
      <code class="licence-block__attr">European Initiative for Security Studies &mdash; eiss-europa.com</code>
    </p>
    <p class="licence-block__text"><a href="{{ '/licensing.html' | localizedHref(lang) }}">{{ lb.linkText }}</a></p>
  </div>
</aside>
