{# Locale-aware Anthology Atlas link-card in the archive page header.
   Reads: lang, i18n.
   Requires: i18n (atlasSignpost.title and atlasSignpost.sub for the locale).
   Optional: lang (default "en" for copy). localizedHref(lang) selects the
             translated Atlas URL when that page exists, otherwise English.
   Reuses the speakers-cta classes and the Anthology constellation mark. #}
{% from "icons.njk" import icon %}
{%- set t = i18n[lang or "en"] -%}
<a class="speakers-cta" href="{{ '/anthology-atlas.html' | localizedHref(lang) }}">
  {# The Anthology/Atlas constellation, not a generic glyph: the iconmark is
     already a constellation and the Atlas is a network map of the field, so
     the sub-brand shows that rather than inventing a second language
     (BRAND.md). The hub follows currentColor from .speakers-cta__icon, the
     network keeps --brand-network. #}
  <span class="speakers-cta__icon speakers-cta__icon--mark" aria-hidden="true">{% inlineSvg "assets/images/brand/anthology-mark.svg" %}</span>
  <span class="speakers-cta__body">
    <span class="speakers-cta__title">{{ t.atlasSignpost.title }}</span>
    <span class="speakers-cta__sub muted">{{ t.atlasSignpost.sub }}</span>
  </span>
  <span class="speakers-cta__arrow" aria-hidden="true">{{ icon("arrow-right") }}</span>
</a>
