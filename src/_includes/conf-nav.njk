{#- conf-nav.njk: the section bar of a conference page in its call for
    papers state. It sits under the hero and stays pinned below the site
    header, so a reader deep in the call still sees where they are and can
    jump. Plain anchors: without JS the links still work. theme.js marks the
    section on screen with aria-current and keeps the bar under the header.
    Kept between editions with cfp.njk: do not delete it as unused while
    no page is in its call state (docs/new-conference.md).
    Needs `lang`. The FR and DE labels are machine translations (CLAUDE.md §1). -#}
{%- set N = {
  en: { label: "On this page", items: [["call-for-papers", "Call"], ["key-dates", "Key dates"], ["closed-panels", "Closed panels"], ["format", "Format"], ["chairs", "Chairs"], ["venue", "Venue"]] },
  fr: { label: "Sur cette page", items: [["call-for-papers", "Appel"], ["key-dates", "Dates clés"], ["closed-panels", "Panels fermés"], ["format", "Format"], ["chairs", "Présidence"], ["venue", "Lieu"]] },
  de: { label: "Auf dieser Seite", items: [["call-for-papers", "Call"], ["key-dates", "Termine"], ["closed-panels", "Geschlossene Panels"], ["format", "Format"], ["chairs", "Vorsitz"], ["venue", "Ort"]] }
}[lang] -%}
<nav class="confnav" data-confnav aria-label="{{ N.label }}">
  <ul class="confnav-list container">
    {%- for item in N.items %}
    <li><a href="#{{ item[0] }}">{{ item[1] }}</a></li>
    {%- endfor %}
  </ul>
</nav>
