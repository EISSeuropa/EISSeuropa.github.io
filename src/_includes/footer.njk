{# Footer consumes the active-locale catalog `t` from base.njk.
   Brand+legal text is i18n'd; link `href` values point at the
   `.lang.html` sibling when it exists, and fall back to the English
   page otherwise via the `localizedHref` filter (#162). #}
{% from "icons.njk" import icon %}
<footer class="site-footer" role="contentinfo" data-pagefind-ignore="all">
  <div class="container footer">
    <div class="footer-grid">
      <div>
        {# Footer brand block. The footer is a wider, quieter surface
           than the header — it can carry the full lockup (constellation
           + EiSS + tagline) as a polished sign-off. The site.fullName
           text is redundant (already in the SVG) so it's dropped here;
           the visually-hidden caption keeps the brand accessible to
           screen readers without doubling the on-screen text. #}
        <div class="footer-brand">
          <span class="brand-logo brand-logo--footer" aria-hidden="true">
            {% inlineSvg "assets/images/brand/logo-full.svg" %}
          </span>
          <span class="sr-only">{{ site.fullName }}</span>
        </div>
        <p class="text-subtle">
          {{ t.footer.tagline }}
        </p>
      </div>

      <nav aria-labelledby="footer-h-conferences">
        <h2 id="footer-h-conferences">{{ t.footer.conferencesHeading }}</h2>
        <ul class="footer-list">
          <li><a href="{{ '/2026.html' | localizedHref(lang) }}">{{ t.footer.conferencesItems.c2026 }}</a></li>
          <li><a href="{{ '/2025.html' | localizedHref(lang) }}">{{ t.footer.conferencesItems.c2025 }}</a></li>
          <li><a href="{{ '/2024.html' | localizedHref(lang) }}">{{ t.footer.conferencesItems.c2024 }}</a></li>
          <li><a href="{{ '/past.html' | localizedHref(lang) }}">{{ t.footer.conferencesItems.allPast }}</a></li>
          <li><a href="{{ '/anthology.html' | localizedHref(lang) }}">{{ t.footer.conferencesItems.navigator }}</a></li>
        </ul>
      </nav>

      <nav aria-labelledby="footer-h-programmes">
        <h2 id="footer-h-programmes">{{ t.footer.programmesHeading }}</h2>
        <ul class="footer-list">
          <li><a href="{{ '/NetSecSchool.html' | localizedHref(lang) }}">{{ t.footer.programmesItems.netsec }}</a></li>
          <li><a href="{{ '/euroswamos.html' | localizedHref(lang) }}">{{ t.footer.programmesItems.euroswamos }}</a></li>
          <li><a href="{{ '/coercion.html' | localizedHref(lang) }}">{{ t.footer.programmesItems.coercion }}</a></li>
          <li><a href="{{ '/GlobalRisks.html' | localizedHref(lang) }}">{{ t.footer.programmesItems.globalRisks }}</a></li>
        </ul>
      </nav>

      <nav aria-labelledby="footer-h-about">
        <h2 id="footer-h-about">{{ t.footer.aboutHeading }}</h2>
        <ul class="footer-list">
          <li><a href="{{ '/initiative.html' | localizedHref(lang) }}">{{ t.footer.aboutItems.initiative }}</a></li>
          <li><a href="{{ '/board.html' | localizedHref(lang) }}">{{ t.footer.aboutItems.people }}</a></li>
          <li><a href="{{ '/membership.html' | localizedHref(lang) }}">{{ t.footer.aboutItems.membership }}</a></li>
          <li><a href="{{ '/internship.html' | localizedHref(lang) }}">{{ t.footer.aboutItems.internship }}</a></li>
          <li><a href="{{ '/blog.html' | localizedHref(lang) }}">{{ t.footer.aboutItems.blog }}</a></li>
          <li><a href="{{ site.newsletterUrl }}" target="_blank" rel="noopener">{{ t.footer.aboutItems.newsletter }}</a></li>
          <li><a href="mailto:{{ site.contactEmail }}">{{ t.footer.aboutItems.contact }}</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-social" role="group" aria-label="{{ t.footer.followUs }}">
      <span class="footer-social-label">{{ t.footer.followUs }}</span>
      <a class="footer-social-link" href="{{ site.social.linkedin }}" target="_blank" rel="noopener" aria-label="{{ t.footer.socialLabel.linkedin }}">
        {{ icon("linkedin") }}
      </a>
      <a class="footer-social-link" href="{{ site.social.twitter }}" target="_blank" rel="noopener" aria-label="{{ t.footer.socialLabel.twitter }}">
        {{ icon("twitter") }}
      </a>
      <a class="footer-social-link" href="{{ site.social.youtube }}" target="_blank" rel="noopener" aria-label="{{ t.footer.socialLabel.youtube }}">
        {{ icon("youtube") }}
      </a>
    </div>

    <div class="footer-fineprint">
      <p>
        <span class="footer-credit">{{ t.footer.copyright | replace("{{year}}", "" | year) }}</span>
      </p>
      {# Light trim: image credits + legal status used to be two separate
         paragraphs. Merged into one fine-print line so the footer doesn't
         feel bottom-heavy. #}
      <p>
        <span class="footer-credit">{{ t.footer.imageCredits }}</span>
        <span aria-hidden="true">&nbsp;·&nbsp;</span>
        {%- set legal = t.footer.legalStatus.split(" | ") %}
        <span lang="en">{{ legal[0] }}</span>
        <span aria-hidden="true">|</span>
        <span lang="fr">{{ legal[1] }}</span>
      </p>
      <div class="footer-meta">
        <nav class="footer-meta-links" aria-label="{{ t.footer.legalNav }}">
          <ul class="footer-meta-list">
            <li><a href="{{ '/terms.html' | localizedHref(lang) }}">{{ t.footer.legalLinks.terms }}</a></li>
            <li><a href="{{ '/policy.html' | localizedHref(lang) }}">{{ t.footer.legalLinks.privacy }}</a></li>
            <li><a href="{{ '/accessibility.html' | localizedHref(lang) }}">{{ t.footer.legalLinks.accessibility }}</a></li>
            <li><a href="{{ '/sitemap.html' | localizedHref(lang) }}">{{ t.footer.legalLinks.sitemap }}</a></li>
            <li><a href="{{ '/licensing.html' | localizedHref(lang) }}">{{ t.footer.legalLinks.licensing }}</a></li>
            <li><a href="{{ '/roadmap.html' | localizedHref(lang) }}">{{ t.footer.legalLinks.roadmap }}</a></li>
            <li><a href="{{ '/press-kit.html' | localizedHref(lang) }}">{{ t.footer.legalLinks.pressKit }}</a></li>
            <li><a href="{{ '/news.html' | localizedHref(lang) }}">{{ t.news.pageTitle }}</a></li>
            <li><a href="/feed.xml">{{ t.news.feedLabel }}</a></li>
          </ul>
        </nav>
        {# Authorship credit. The name links to the author's board card
           via the slug from src/_data/board.json. Keep this discreet —
           it doesn't compete with EISS branding. #}
        <span class="footer-authorship">
          {{ t.footer.authorship.prefix }}
          <a href="{{ '/board.html' | localizedHref(lang) }}#{{ t.footer.authorship.authorSlug }}">{{ t.footer.authorship.authorName }}</a>
        </span>
      </div>
    </div>
  </div>
</footer>
