{# Homepage host-city map: the ESSC's travels across Europe, beside a link to
   the archive. (Its one-line lead opens the Conference card in
   home-pillars.njk, higher up.) The map is the shared essc-map.njk that
   /initiative uses, so both follow conferences.js. #}
{% from "icons.njk" import icon %}
{%- set _lang = lang or "en" -%}
{%- set t = i18n[_lang] -%}
{%- if conferences.mapCities.length %}
<section class="section" aria-labelledby="home-map-title">
  <div class="container home-map">
    <div class="home-map__text">
      <span class="eyebrow">{{ t.esscMap.eyebrow }}</span>
      <h2 id="home-map-title">{{ t.esscMap.heading }}</h2>
      <a class="btn btn-secondary" href="{{ '/past.html' | localizedHref(_lang) }}">{{ t.esscMap.archive }} {{ icon("arrow-right") }}</a>
    </div>
    <figure class="home-map__figure card">
      {% include "essc-map.njk" %}
    </figure>
  </div>
</section>
{%- endif %}
