{# Homepage host-city timeline: the ESSC's travels across Europe as a ruled
   row of cities, oldest first, the next host marked. Reads the same
   conferences.mapCities as the essc-map.njk map on /initiative, so both
   follow conferences.js. #}
{% from "icons.njk" import icon %}
{%- set _lang = lang or "en" -%}
{%- set t = i18n[_lang] -%}
{%- if conferences.mapCities.length %}
<section class="section" aria-labelledby="home-map-title">
  <div class="container">
    <div class="home-map__head">
      <div>
        <span class="eyebrow">{{ t.esscMap.eyebrow }}</span>
        <h2 id="home-map-title">{{ t.esscMap.heading }}</h2>
      </div>
      <a class="link-arrow" href="{{ '/past.html' | localizedHref(_lang) }}">{{ t.esscMap.archive }} {{ icon("arrow-right", "icon-inline") }}</a>
    </div>
    <ol class="home-map__list" role="list">
      {%- for c in conferences.mapCities %}
      <li class="home-map__stop{% if c.isNext %} home-map__stop--next{% endif %}">
        <a href="{{ ('/' + c.slug + '.html') | localizedHref(_lang) }}">{{ (c.cityLabel and c.cityLabel[_lang]) or c.city }}</a>
        <span class="home-map__years">{{ c.yearsLabel | replace(" - ", "–") }}{% if c.isNext %} · {{ t.esscMap.next }}{% endif %}</span>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>
{%- endif %}
