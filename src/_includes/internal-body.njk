      }
      var alarm = overall === "issue" || overall === "critical";
      var dot = document.querySelector("[data-apps-it-dot]");
      setDot(dot, overall);
      dot.hidden = !alarm;
      document.querySelector("[data-apps-it-note]").hidden = !alarm;
    }
    // GitHub's own status page, live, since the build runs on GitHub Actions and
    // seldom runs during a GitHub outage. Same rule as githubLevel() in
    // systemHealth.js. On failure the build's value stays.
    var GH_PARTS = ["Actions", "Pages", "Git Operations", "API Requests", "Pull Requests", "Webhooks"];
    function loadGithubStatus() {
      if (!data.health) return;
      fetch("https://www.githubstatus.com/api/v2/summary.json").then(function (r) {
        if (!r.ok) throw new Error(r.status);
        return r.json();
      }).then(function (sum) {
        var hit = sum.components.filter(function (c) { return GH_PARTS.indexOf(c.name) > -1 && c.status !== "operational"; });
        var level = hit.some(function (c) { return c.status === "major_outage" && (c.name === "Actions" || c.name === "Pages"); }) ? "critical" : hit.length ? "issue" : "nominal";
        var names = hit.map(function (c) { return c.name; });
        data.health.github = { level: level, components: names };
        var line = document.querySelector("[data-apps-github-level]");
        if (line) { setDot(line.querySelector(".apps-dot"), level); line.lastElementChild.textContent = LEVELS[level]; }
        var text = document.querySelector("[data-apps-github-text]");
        if (text) text.textContent = LEVELS[level] + (names.length ? ": " + names.join(", ") : "");
        markLive("ghstatus");
        rollup();
      }).catch(function () {});
    }
    loadGithubStatus();
    // A block's light turns live once its figures come from the live load.
    function markLive(key) {
      document.querySelectorAll('[data-apps-src="' + key + '"]').forEach(function (el) {
        el.classList.add("is-live");
        el.setAttribute("aria-label", I.srcLive);
        el.title = I.srcLive;
      });
    }
    function renderHelp(items) {
      var ul = document.querySelector("[data-apps-help]");
      if (!ul) return;
      ul.textContent = "";
      items.forEach(function (x) {
        var li = document.createElement("li");
        li.innerHTML = '<a><span class="apps-help-num"></span> <span></span></a>';
        // Built from the issue number, so only this repo's issues are linked.
        li.firstChild.href = "https://github.com/EISSeuropa/EISSeuropa.github.io/issues/" + Number(x.n);
        li.querySelector(".apps-help-num").textContent = "#" + x.n;
        li.firstChild.lastChild.textContent = x.title;
        ul.appendChild(li);
      });
      ul.hidden = !items.length;
    }
    function applyLive(live, at) {
      ["issues", "prs", "tasks"].forEach(function (k) {
        document.querySelectorAll('[data-apps-live="' + k + '"]').forEach(function (el) { el.textContent = live[k]; });
      });
      if (live.help) renderHelp(live.help);
      markLive("counts");
      if (live.recent) markLive("rolls");
      if (live.runs && live.runs.length) markLive("runs");
      if (live.total) {
        markLive("release");
        releaseTotal = live.total;
        var pct = Math.round(live.closed / live.total * 100);
        var el = document.querySelector("[data-apps-release-percent]");
        if (el) el.textContent = pct + "%";
        var bar = document.querySelector("[data-apps-release-bar]");
        if (bar) { bar.max = live.total; bar.value = live.closed; bar.textContent = pct + "%"; }
        var note = document.querySelector("[data-apps-release-note]");
        if (note) note.textContent = f(DASH.issuesClosed, { closed: live.closed, total: live.total });
      }
      if (data.health) applyHealth(live);
      var mins = Math.round((Date.now() - at) / 6e4);
      var line = document.querySelector(".apps-live");
      line.classList.add("is-live");
      line.textContent = f(I.liveChecked, { when: mins < 1 ? I.justNow : pl(I.minAgo, mins) });
      recent = (live.recent || data.recent || []).filter(function (x) { return isRun(x.url); });
      compare(live.tasks, live.closed === null ? built.closed : live.closed, at, live.done);
      if (live.done) renderPace(live.done);
    }
    // The release's pace: issues closed per day over the last 30 days, from the
    // closed-issue list the live load already fetches. Oldest day on the left.
    var DAYS = 30;
    function dayStart(d) { return new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime(); }
    function renderPace(done) {
      var box = document.querySelector("[data-apps-pace]");
      if (!box) return;
      var today = dayStart(new Date()), counts = [];
      for (var i = 0; i < DAYS; i++) counts.push(0);
      done.forEach(function (x) {
        var ago = Math.round((today - dayStart(new Date(x.at))) / 864e5);
        if (ago >= 0 && ago < DAYS) counts[DAYS - 1 - ago]++;
      });
      var total = counts.reduce(function (a, b) { return a + b; }, 0);
      var week = counts.slice(-7).reduce(function (a, b) { return a + b; }, 0);
      var top = Math.max.apply(null, counts), scale = Math.max(top, 3);
      function dayLabel(i) {
        return new Date(today - (DAYS - 1 - i) * 864e5).toLocaleDateString(LOC, { weekday: "short", day: "numeric", month: "short" });
      }
      document.querySelector("[data-apps-pace-summary]").textContent = total
        ? pl(I.paceSummary, total, { w: week })
        : I.paceNone;
      var bars = document.querySelector("[data-apps-pace-bars]");
      var rows = document.querySelector("[data-apps-pace-rows]");
      bars.textContent = "";
      rows.textContent = "";
      var peakShown = false;
      counts.forEach(function (n, i) {
        var bar = document.createElement("span");
        bar.className = "apps-pace-bar" + (n ? "" : " apps-pace-zero");
        bar.style.setProperty("--h", n / scale);
        bar.style.setProperty("--i", i);
        bar.setAttribute("data-n", n);
        bar.setAttribute("data-day", dayLabel(i));
        // The busiest day carries its figure, once.
        if (n && n === top && !peakShown) {
          peakShown = true;
          var v = document.createElement("span");
          v.className = "apps-pace-peak";
          v.textContent = n;
          bar.appendChild(v);
        }
        bars.appendChild(bar);
        if (n) {
          var tr = document.createElement("tr"), td1 = document.createElement("td"), td2 = document.createElement("td");
          td1.textContent = dayLabel(i);
          td2.textContent = n;
          tr.appendChild(td1);
          tr.appendChild(td2);
          rows.insertBefore(tr, rows.firstChild);
        }
      });
      box.querySelector(".apps-pace-table").hidden = !total;
      box.hidden = false;
    }
    // One tooltip for every bar: the count leads, the day follows.
    (function () {
      var plot = document.querySelector(".apps-pace-plot");
      if (!plot) return;
      var tip = plot.querySelector("[data-apps-pace-tip]");
      plot.addEventListener("pointermove", function (e) {
        var bar = e.target.closest(".apps-pace-bar");
        if (!bar) { tip.hidden = true; return; }
        var n = +bar.getAttribute("data-n");
        tip.textContent = "";
        var strong = document.createElement("strong");
        strong.textContent = f(I.nClosed, { n: n });
        tip.appendChild(strong);
        tip.appendChild(document.createTextNode(" " + bar.getAttribute("data-day")));
        tip.hidden = false;
        var p = plot.getBoundingClientRect(), b = bar.getBoundingClientRect();
        var x = b.left + b.width / 2 - p.left, half = tip.offsetWidth / 2;
        tip.style.left = Math.min(Math.max(x, half), p.width - half) + "px";
      });
      plot.addEventListener("pointerleave", function () { tip.hidden = true; });
    })();

    var LIVE = "eiss-apps-live", cached = null;
    try { cached = JSON.parse(localStorage.getItem(LIVE)); } catch (e) {}
    if (cached && Date.now() - cached.at < 6e5) applyLive(cached.live, cached.at);
    else loadLive().then(function (live) {
      var at = Date.now();
      try { localStorage.setItem(LIVE, JSON.stringify({ at: at, live: live })); } catch (e) {}
      applyLive(live, at);
    }).catch(function () { compare(built.tasks, built.closed); });
    if (!calm) document.querySelectorAll("[data-apps-count]").forEach(function (el) {
      var end = +el.textContent, start = performance.now();
      (function step(t) {
        var k = Math.min((t - start) / 900, 1);
        el.textContent = Math.round(end * (1 - Math.pow(1 - k, 3)));
        if (k < 1) requestAnimationFrame(step);
      })(start);
    });

    // A soft light follows the pointer across the cards.
    document.querySelectorAll(".apps-tile").forEach(function (a) {
      a.addEventListener("pointermove", function (e) {
        var r = a.getBoundingClientRect();
        a.style.setProperty("--mx", e.clientX - r.left + "px");
        a.style.setProperty("--my", e.clientY - r.top + "px");
      });
    });

    // The constellation behind the logo. It drifts for four seconds and comes
    // to rest (RGAA 13.8: motion past five seconds needs a pause control), and
    // moves again only under the reader's pointer.
    var hero = document.querySelector("[data-apps-hero]");
    var c = hero.querySelector("canvas"), ctx = c.getContext("2d");
    var nodes = [], ptr = null, until = 0, running = false, W, H, dpr;
    function size() {
      dpr = Math.min(devicePixelRatio || 1, 2);
      W = hero.clientWidth; H = hero.clientHeight;
      c.width = W * dpr; c.height = H * dpr;
      var want = Math.min(70, Math.round(W * H / 14000));
      while (nodes.length < want) nodes.push({ x: Math.random() * W, y: Math.random() * H, vx: (Math.random() - 0.5) * 0.35, vy: (Math.random() - 0.5) * 0.35 });
      nodes.length = want;
    }
    function draw(step) {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      var pts = ptr ? nodes.concat(ptr) : nodes;
      pts.forEach(function (a, i) {
        if (a !== ptr) {
          a.x = (a.x + a.vx * step + W) % W;
          a.y = (a.y + a.vy * step + H) % H;
        }
        for (var j = i + 1; j < pts.length; j++) {
          var b = pts[j], d = Math.hypot(a.x - b.x, a.y - b.y);
          if (d < 130) {
            ctx.strokeStyle = "rgba(115, 202, 255, " + (0.32 * (1 - d / 130)) + ")";
            ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
          }
        }
        ctx.fillStyle = "rgba(115, 202, 255, 0.7)";
        ctx.beginPath(); ctx.arc(a.x, a.y, 1.6, 0, 7); ctx.fill();
      });
    }
    function run() {
      if (running) return;
      running = true;
      (function frame() {
        var left = until - performance.now();
        if (left <= 0) { running = false; return; }
        draw(Math.min(left / 800, 1));
        requestAnimationFrame(frame);
      })();
    }
    size();
    draw(0);
    new ResizeObserver(function () { size(); draw(0); }).observe(hero);
    if (!calm) {
      until = performance.now() + 4000;
      run();
      hero.addEventListener("pointermove", function (e) {
        var r = hero.getBoundingClientRect();
        ptr = { x: e.clientX - r.left, y: e.clientY - r.top };
        until = performance.now() + 900;
        run();
      });
      hero.addEventListener("pointerleave", function () { ptr = null; until = performance.now() + 400; run(); });
    }

    // A click on an app shows that it is opening, since some take seconds to answer.
    // The apps grid. The three apps opened most often on this device (three
    // times or more) come first, and the field above filters the tiles, the
    // rest closing up around the matches. Counts stay in this browser.
    var grid = document.querySelector("#apps .apps-grid");
    var USED = "eiss-apps-used", used = {};
    try { used = JSON.parse(localStorage.getItem(USED)) || {}; } catch (e) {}
    function hrefOf(li) { var a = li.querySelector("a.apps-tile"); return a ? a.getAttribute("href") : null; }
    function uses(li) { return used[hrefOf(li)] || 0; }
    [].slice.call(grid.children).filter(function (li) { return uses(li) >= 3; })
      .sort(function (a, b) { return uses(b) - uses(a); }).slice(0, 3).reverse()
      .forEach(function (li) { grid.insertBefore(li, grid.firstChild); });
    [].forEach.call(grid.children, function (li, i) { li.style.setProperty("--n", i); });
    grid.addEventListener("click", function (e) {
      var li = e.target.closest("li"), key = li && hrefOf(li);
      if (!key) return;
      used[key] = (used[key] || 0) + 1;
      try { localStorage.setItem(USED, JSON.stringify(used)); } catch (err) {}
    });

    var filterBox = document.querySelector("[data-apps-filter-box]");
    var filter = document.querySelector("[data-apps-filter]");
    var empty = document.querySelector("[data-apps-filter-empty]");
    function shown() { return [].filter.call(grid.children, function (li) { return li.offsetParent !== null; }); }
    function applyFilter() {
      var q = filter.value.trim().toLowerCase();
      var before = new Map();
      shown().forEach(function (li) { before.set(li, li.getBoundingClientRect()); });
      [].forEach.call(grid.children, function (li) {
        li.classList.toggle("apps-filtered-out", !!q && li.textContent.toLowerCase().indexOf(q) < 0);
      });
      var now = shown();
      // The tiles that stay glide from where they were to where they land.
      if (!calm) now.forEach(function (li) {
        var was = before.get(li);
        if (!was) return;
        var to = li.getBoundingClientRect(), dx = was.left - to.left, dy = was.top - to.top;
        if (dx || dy) li.animate([{ transform: "translate(" + dx + "px, " + dy + "px)" }, { transform: "none" }], { duration: 320, easing: "cubic-bezier(0.22, 1, 0.36, 1)" });
      });
      empty.hidden = !q || now.length > 0;
      empty.textContent = f(I.noMatch, { q: filter.value.trim() });
      document.querySelector("[data-apps-status]").textContent = q ? pl(I.matches, now.length) : "";
    }
    filter.addEventListener("input", applyFilter);
    filter.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && filter.value) { e.preventDefault(); filter.value = ""; applyFilter(); }
    });
    roleSelect.addEventListener("change", function () { if (filter.value) applyFilter(); });
    filterBox.hidden = false;

    // A new-tab click leaves this page in place, so it gets no animation.
    var launched = null, timer;
    function stopLaunch() {
      clearTimeout(timer);
      if (launched) launched.classList.remove("is-launching");
      launched = null;
    }
    document.addEventListener("click", function (e) {
      var tile = e.target.closest && e.target.closest("a.apps-tile");
      if (!tile || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      stopLaunch();
      launched = tile;
      tile.classList.add("is-launching");
      document.querySelector("[data-apps-status]").textContent = f(I.opening, { app: tile.querySelector(".apps-label").textContent });
      timer = setTimeout(stopLaunch, 15000);
    });
    // Coming back with the browser's Back button restores the page as it was left.
    addEventListener("pageshow", stopLaunch);
  })();
</script>
