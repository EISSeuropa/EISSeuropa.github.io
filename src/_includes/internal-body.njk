{#
  internal.njk: the apps dashboard for staff, board members and volunteers,
  after Google Workspace's "Your apps" page. internal.eiss-europa.com
  redirects here from a separate one-file repo (GitHub Pages serves one
  custom domain per repo).

  Reads: site.staffLinks (entries with `roles`), labels t.staffMenu.<key> or
  the entry's own `label`, site.guideLinks, systemHealth and dashboard (release,
  counts, dates, deadlines, phase, recent, board) and netsecReport.
  The role filter is CSS `:has()` on data-roles, so it works without JS. So does
  the page, with every tab's section stacked.
  A shortcut list, not access control. Everything works without JS: the script
  only adds the first-visit prompt, greeting, clock, live day counts, app count,
  remembered role, Today line, live GitHub figures, card spotlight and the hero
  constellation. Without it the strip shows the figures of the last build.
  #admin: an unlisted view (site.adminLinks) shown by CSS `:target`. Hidden
  from view, not secret: the links are in the source of this public page.

  Shared by internal.njk, internal.fr.njk and internal.de.njk. Page strings
  are t.dash in i18n.js (t.dash.js for the script). site.js entries carry
  their own fr/de overrides. Key dates and stages from the "EISS dates"
  calendar stay as staff typed them.
#}
{% from "icons.njk" import icon %}
{%- set t = i18n[lang or "en"] -%}
{%- set d = t.dash -%}
{#- A data block's light: dark green while it shows the build's figures, light
    green and glowing once the live load replaces them (data-apps-src names the
    load). The legend sits at the foot of the page. -#}
{%- set STORED = d.stored | replace("{date}", dashboard.built | newsDate(lang)) -%}
{%- set SRC = '<span class="apps-src" data-apps-src="@" role="img" aria-label="' + STORED + '" title="' + STORED + '"></span>' -%}

{# Opens the connection to Indico ahead of the click. #}
<link rel="preconnect" href="https://indico.eiss-europa.com">
<div class="apps-page">
  <p class="sr-only" role="status" data-apps-status></p>
  <header class="apps-hero" data-apps-hero>
    <canvas class="apps-hero-canvas" aria-hidden="true"></canvas>
    <div class="container apps-hero-inner">
      <div class="apps-hero-logo">{% inlineSvg "assets/images/brand/eiss-10-lockup.svg" %}</div>
      <h1 class="apps-hero-title">{{ t.staffMenu.heading }}</h1>
      <p class="apps-hero-clock" data-apps-clock hidden></p>
      <p class="apps-hero-lead">{{ d.lead }}</p>
    </div>
  </header>

  <div class="container">
    {# The welcome: on a first visit, asks the role, then walks through that
       role's joining steps one at a time. Reopened from Guides. Without JS
       it never opens and the Joining Guide covers the same ground.
       ponytail: steps, not a saved checklist. Add per-step ticks if
       people ask to resume where they stopped. #}
    <dialog class="apps-welcome" data-apps-welcome aria-labelledby="apps-welcome-title">
      <button type="button" class="apps-welcome-close" data-apps-welcome-close aria-label="{{ d.welcomeClose }}">&times;</button>
      <div data-apps-welcome-role>
        <h2 class="apps-welcome-title" id="apps-welcome-title">{{ d.welcomeTitle }}</h2>
        <p class="apps-welcome-lead">{{ d.welcomeLead }}</p>
        <div class="apps-welcome-choices">
          <button type="button" class="btn btn-secondary" data-apps-choose="staff" autofocus>{{ d.roles.staff }}</button>
          <button type="button" class="btn btn-secondary" data-apps-choose="management">{{ d.roles.management }}</button>
          <button type="button" class="btn btn-secondary" data-apps-choose="board">{{ d.roles.board }}</button>
          <button type="button" class="btn btn-secondary" data-apps-choose="volunteer">{{ d.roles.volunteer }}</button>
        </div>
        <button type="button" class="apps-welcome-skip" data-apps-welcome-close>{{ d.skip }}</button>
      </div>
      <div data-apps-welcome-steps hidden>
        <p class="apps-welcome-meta" data-apps-welcome-meta aria-live="polite"></p>
        <progress class="apps-progress" data-apps-welcome-bar value="0" max="1" aria-hidden="true"></progress>
        <ol class="apps-welcome-list" role="list">
          {% for stage in dashboard.onboarding %}{% set G = stage[lang] or {} %}{% for s in stage.steps %}{% set S = s[lang] or {} %}
            <li class="apps-welcome-step{% if s.key %} apps-welcome-key{% endif %}" data-roles="{{ s.roles | join(' ') }}" data-stage="{{ G.stage or stage.stage }}">
              {% if s.key %}<p class="apps-welcome-badge">{{ icon("lightbulb") }} {{ S.key or s.key }}</p>{% endif %}
              <h3 class="apps-welcome-heading" tabindex="-1">{{ S.title or s.title }}</h3>
              {% if s.text %}<p>{{ S.text or s.text }}</p>{% endif %}
              {% if s.moving %}<p class="apps-welcome-moving"><strong>{{ d.alreadyWithEiss }}</strong> {{ S.moving or s.moving }}</p>{% endif %}
              {% if s.links.length %}
                <ul class="apps-welcome-links" role="list">
                  {% for l in s.links %}
                    <li{% if l.roles %} data-roles="{{ l.roles | join(' ') }}"{% endif %}><a class="btn btn-secondary btn-sm" href="{{ l.href | localizedHref(lang) }}" target="_blank" rel="noopener">{{ icon(l.icon) }} {{ (l[lang] and l[lang].label) or l.label or t.staffMenu[l.key] }}</a></li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}{% endfor %}
        </ol>
        <div class="apps-welcome-nav">
          <button type="button" class="btn btn-secondary" data-apps-welcome-back>{{ d.back }}</button>
          <button type="button" class="btn btn-primary" data-apps-welcome-next>{{ d.next }}</button>
        </div>
      </div>
    </dialog>

    <dl class="apps-stats">
      {% set deadline = dashboard.deadlines[0] %}
      {% if deadline %}
        <div class="apps-stat" data-apps-deadline>
          <dt data-apps-deadline-label>{{ (deadline[lang] and deadline[lang].label) or deadline.label }}</dt>
          <dd><a href="#status" data-apps-deadline-days>{{ deadline.date | daysUntil }} {{ d.days }}</a></dd>
        </div>
      {% endif %}
      {% if facts.conferences.next %}
        <div class="apps-stat">
          <dt>{{ d.untilEssc | replace("{year}", facts.conferences.next.startDate | truncate(4, true, "")) | replace("{city}", facts.conferences.next.city) }}</dt>
          <dd><a href="{{ ("/" + (facts.conferences.next.startDate | truncate(4, true, "")) + ".html") | localizedHref(lang) }}" data-apps-countdown="{{ facts.conferences.next.startDate }}" data-apps-count>{{ facts.conferences.next.startDate | daysUntil }}</a></dd>
        </div>
      {% endif %}
      {% if systemHealth %}
        <div class="apps-stat{% if systemHealth.summary.url %} apps-stat-{{ systemHealth.summary.level }}{% endif %}" data-apps-systems>
          <dt>{{ d.systems }}</dt>
          <dd class="apps-stat-level"><span class="apps-dot apps-dot-{{ systemHealth.summary.level }}" data-apps-systems-dot aria-hidden="true"></span>{% if systemHealth.summary.url %}<a href="{{ systemHealth.summary.url }}" data-apps-systems-label>{{ d.levels[systemHealth.summary.level] }}</a>{% else %}<a data-apps-systems-label>{{ d.levels[systemHealth.summary.level] }}</a>{% endif %}</dd>
        </div>
      {% endif %}
      {% if dashboard.release %}
        <div class="apps-stat">
          <dt>{{ dashboard.release.title }}{% if dashboard.release.due %}{{ d.dueOn | replace("{date}", dashboard.release.due | newsDate(lang)) }}{% endif %}</dt>
          <dd><a href="{{ dashboard.release.url }}" data-apps-release-percent>{{ dashboard.release.percent }}%</a></dd>
        </div>
      {% endif %}
      {% if dashboard.counts %}
        <div class="apps-stat">
          <dt>{{ d.counts.tasks }}</dt>
          <dd><a href="{{ dashboard.counts[2].url }}" data-apps-live="tasks">{{ dashboard.counts[2].value }}</a></dd>
        </div>
      {% endif %}
    </dl>
    <p class="apps-live" data-apps-asof>{% if systemHealth %}{{ d.asOf | replace("{date}", systemHealth.checked | newsDate(lang)) }}{% endif %}</p>
    {# The conference timeline: the stage of the conference year with its
       stepper, then the coming dates as calendar tiles. #}
    {% if dashboard.phase or dashboard.agenda.length %}
    <section class="apps-conference" aria-labelledby="apps-conference-heading">
    <h2 class="apps-heading" id="apps-conference-heading">{{ d.agenda.heading }}</h2>
    {% if dashboard.phase %}
      <div class="apps-phase">
        <div>
          <h3 class="apps-phase-title">{{ d.agenda.conference }}</h3>
          {% set np = dashboard.phase.noteParts %}
          <p class="apps-note">{{ d.now | replace("{label}", d.esscOn | replace("{year}", dashboard.phase.year) if dashboard.phase.conference else ((dashboard.phase[lang] and dashboard.phase[lang].label) or dashboard.phase.label)) }}. {% if np.kind == "until" %}{{ d.inCityUntil | replace("{city}", np.city) | replace("{date}", np.date | newsDate(lang)) }}{% elif np %}{{ d.nextUp | replace("{label}", d.esscOpens | replace("{year}", np.year) | replace("{city}", np.city) if np.kind == "essc" else ((np[lang] and np[lang].label) or np.label)) | replace("{date}", np.date | newsDate(lang)) }}{% endif %}</p>
        </div>
        <ul class="apps-phase-links" role="list">
          {% for l in dashboard.phase.links %}
            <li data-roles="{{ l.roles | join(' ') }}"><a class="btn btn-secondary btn-sm" href="{{ l.href }}">{{ icon(l.icon) }} {{ t.staffMenu[l.key] or l.label }}</a></li>
          {% endfor %}
        </ul>
        <ol class="apps-steps" aria-label="{{ d.stagesLabel }}" style="--apps-steps-n: {{ dashboard.phase.steps.length }}; --apps-steps-fill: {{ dashboard.phase.fill }}">
          {% for s in dashboard.phase.steps %}
            <li class="apps-step apps-step-{{ s.state }}"{% if s.state == "now" %} aria-current="step"{% endif %}><span class="apps-step-dot" aria-hidden="true"></span><span class="apps-step-label">{{ (s[lang] and s[lang].step) or s.step }}{% if s.state == "done" %}<span class="sr-only">{{ d.done }}</span>{% endif %}</span></li>
          {% endfor %}
        </ol>
      </div>
    {% endif %}

    {# The conference's pace (#2039): abstracts and registrations for this
       edition, against the previous edition at the same distance from its
       conference. Bars share one scale, the previous edition's final total.
       Figures from scripts/conference-pace.py, procedure in docs/conference-pace.md. #}
    {% set P = dashboard.pace %}
    {% if dashboard.phase %}
      <div class="apps-confpace" data-roles="staff management">
        {% set PST = d.stored | replace("{date}", (P.recorded if P and P.recorded else dashboard.built) | newsDate(lang)) %}
        {% if P %}<span class="apps-src" role="img" aria-label="{{ PST }}" title="{{ PST }}"></span>{% endif %}
        <h3 class="apps-confpace-title">{{ d.confPace.heading }}</h3>
        {% if P %}
          {% for key in ["abstracts", "registrations"] %}{% set m = P.measures[key] %}{% if m %}
            {% set top = m.previous.total if m.previous and m.previous.total > (m.count or 0) else (m.count or 1) %}
            {% set dp = d.confPace.daysOut %}
            <div class="apps-confpace-row">
              <p class="apps-confpace-label">{{ d.confPace[key] }} <span class="apps-confpace-when">{{ (dp[0] if (m.daysOut < 2 if lang == "fr" else m.daysOut == 1) else dp[1]) | replace("{n}", m.daysOut) }}</span></p>
              <dl class="apps-confpace-bars">
                <div class="apps-confpace-now">
                  <dt>{{ m.edition }}</dt>
                  <dd><span class="apps-confpace-track" aria-hidden="true"><span class="apps-confpace-bar" style="width: {{ ((m.count or 0) / top * 100) | round(1) }}%"></span></span><span class="apps-confpace-num"><strong>{{ m.count if m.recorded else d.confPace.notRecorded }}</strong></span></dd>
                </div>
                {% if m.previous %}
                  <div class="apps-confpace-prev">
                    <dt>{{ m.previous.edition }}</dt>
                    <dd><span class="apps-confpace-track" aria-hidden="true"><span class="apps-confpace-bar" style="width: {{ (m.previous.count / top * 100) | round(1) }}%"></span></span><span class="apps-confpace-num"><strong>{{ m.previous.count }}</strong> <span class="apps-confpace-total">{{ d.confPace.ofTotal | replace("{total}", m.previous.total) }}</span></span></dd>
                  </div>
                {% endif %}
              </dl>
            </div>
          {% endif %}{% endfor %}
        {% else %}
          <p class="apps-note">{{ d.confPace.empty }} <a href="https://github.com/EISSeuropa/EISSeuropa.github.io/blob/master/docs/conference-pace.md">{{ d.confPace.how }}</a></p>
        {% endif %}
      </div>
    {% endif %}

    {# Calendar tiles for the coming EISS and NetSec dates, soonest first, from
       dashboard.agenda. One row that scrolls sideways. #}
    {% if dashboard.agenda.length %}
      <ul class="apps-agenda" role="list" aria-label="{{ d.agenda.list }}">
        {% for x in dashboard.agenda %}
          {% set label %}{% if x.kind == "essc" %}{{ d.esscDate | replace("{year}", x.year) | replace("{city}", x.city) }}{% elif x.kind == "release" %}{{ d.releaseDue | replace("{title}", x.title) }}{% elif x.cohort %}{{ d.agenda[x.kind] | replace("{cohort}", x.cohort[lang] or x.cohort.en) }}{% else %}{{ (x[lang] and x[lang].label) or x.label }}{% endif %}{% endset %}
          <li class="apps-agenda-tile apps-agenda-{{ x.cat }}" data-roles="{{ x.roles | join(' ') }}">
            {% if x.url %}<a class="apps-agenda-link" href="{{ x.url | localizedHref(lang) if x.url.startsWith('/') else x.url }}">{% else %}<div class="apps-agenda-link">{% endif %}
              <span class="apps-agenda-month">{{ x.date | monthShort(lang) }}</span>
              <time class="apps-agenda-day" datetime="{{ x.date }}">{{ x.date.slice(8, 10) | int }}{% if x.end and x.end.slice(0, 7) == x.date.slice(0, 7) %}–{{ x.end.slice(8, 10) | int }}{% endif %}</time>
              <span class="apps-agenda-label">{{ label | trim | safe }}{% if x.tentative %} <span class="apps-agenda-tbc">({{ d.agenda.tentative }})</span>{% endif %}</span>
              <span class="apps-agenda-tags"><span class="apps-board-site apps-board-site-{{ x.site | lower }}">{{ x.site }}</span> <span class="apps-agenda-cat">{{ d.agenda.cat[x.cat] }}</span></span>
            {% if x.url %}</a>{% else %}</div>{% endif %}
          </li>
        {% endfor %}
      </ul>
      {% if dashboard.calendar %}<p class="apps-note"><a href="{{ dashboard.calendar }}">{{ d.allDeadlines }}</a></p>{% endif %}
    {% endif %}
    </section>
    {% endif %}

    {# The rolling modules: the issues for every role but the board, then the
       board's features, audits and fixes. Each row is one roll. #}
    <section class="apps-rolls" aria-labelledby="apps-rolls-heading">
    <h2 class="apps-heading" id="apps-rolls-heading">{{ d.rolls.heading }}</h2>
    <div class="apps-today" data-apps-today hidden>
      <div class="apps-today-clip">
        <div class="apps-today-box">
          <p class="apps-today-text" data-apps-today-text hidden></p>
          {% for key in ["closed", "opened"] %}
            <div class="apps-roll-row" data-apps-issue-row="{{ key }}" hidden>
              <p class="apps-roll-label" id="apps-roll-{{ key }}">{{ d.rolls[key] }} {{ SRC | replace("@", "rolls") | safe }}</p>
              <div class="apps-done-stage" data-apps-issue-roll="{{ key }}">
                <ul class="apps-done" data-apps-done role="list" aria-labelledby="apps-roll-{{ key }}"></ul>
                <button type="button" class="apps-done-pause apps-done-more" data-apps-done-more aria-expanded="false" aria-label="{{ d.rolls.showAll | replace("{label}", d.rolls[key]) }}" title="{{ d.rolls.showAll | replace("{label}", d.rolls[key]) }}" hidden>{{ icon("chevron-down") }}</button>
                <button type="button" class="apps-done-pause" data-apps-done-pause aria-pressed="false" aria-label="{{ d.board.pause | replace("{label}", d.rolls[key]) }}" hidden><span class="apps-done-hold">{{ icon("pause") }}</span><span class="apps-done-play">{{ icon("play") }}</span></button>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    {# The board's view: the month's main features and fixes in both site repos,
       and the latest formal audits, each rolling like the issues above. Board
       only, and in the "Everyone" view. Without JS (or motion) the lines stack. #}
    {% set B = dashboard.board %}
    {% set MARK = {
      features: '<path d="M8 4v8M4 8h8"/>',
      audits: '<path d="M7 4a3 3 0 1 0 0 6a3 3 0 1 0 0-6M9.2 9.2l3 3"/>',
      fixes: '<path d="M3.5 8.5l3 3 6-7"/>'
    } %}
    <div class="apps-board" data-roles="board">
      <div class="apps-today-box">
        {% for key in ["features", "audits", "fixes"] %}{% if B[key] and B[key].length %}
          <div class="apps-roll-row">
            <p class="apps-roll-label" id="apps-board-{{ key }}">{{ d.board[key] }} {{ SRC | replace("@", "") | safe }}</p>
            <div class="apps-done-stage" data-apps-roll>
              <ul class="apps-done apps-done-static" data-apps-done role="list" aria-labelledby="apps-board-{{ key }}">
                {% for x in B[key] %}
                  <li class="apps-done-item"><span class="apps-done-box apps-done-box-{{ key }}" aria-hidden="true"><svg viewBox="0 0 16 16">{{ MARK[key] | safe }}</svg></span><a href="{{ x.url }}" title="{{ x.title }}, {{ (x.at or x.date) | newsDate(lang) }}"><span class="apps-board-site apps-board-site-{{ x.site | lower }}">{{ x.site }}</span> <span class="apps-done-title">{{ x.title }}</span></a></li>
                {% endfor %}
              </ul>
              <button type="button" class="apps-done-pause apps-done-more" data-apps-done-more aria-expanded="false" aria-label="{{ d.rolls.showAll | replace("{label}", d.board[key]) }}" title="{{ d.rolls.showAll | replace("{label}", d.board[key]) }}" hidden>{{ icon("chevron-down") }}</button>
              <button type="button" class="apps-done-pause" data-apps-done-pause aria-pressed="false" aria-label="{{ d.board.pause | replace("{label}", d.board[key]) }}" hidden><span class="apps-done-hold">{{ icon("pause") }}</span><span class="apps-done-play">{{ icon("play") }}</span></button>
            </div>
          </div>
        {% endif %}{% endfor %}
      </div>
    </div>
    </section>

    <div class="apps-admin" id="admin">
      <h2 class="apps-heading">{{ d.admin }}</h2>
      <ul class="apps-grid" role="list">
        {% for app in site.adminLinks %}
          <li class="apps-card-wrap" style="--n: {{ loop.index0 }}">
            <a class="apps-tile" href="{{ app.href }}">
              <span class="apps-icon">{{ icon(app.icon) }}</span>
              <span class="apps-label">{{ (app[lang] and app[lang].label) or app.label }}</span>
              <span class="apps-go">{{ icon("arrow-right") }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>

    <div class="apps-tabbar">
      <div class="apps-tabs" role="tablist" aria-label="{{ d.sections }}" data-apps-tabs hidden>
        <button type="button" role="tab" id="apps-tab-apps" aria-controls="apps" data-apps-tab="apps">{{ d.tabApps }}</button>
        <button type="button" role="tab" id="apps-tab-guides" aria-controls="guides" data-apps-tab="guides">{{ d.tabGuides }}</button>
        <button type="button" role="tab" id="apps-tab-status" aria-controls="status" data-apps-tab="status">{{ d.tabStatus }}</button>
        {% if netsecReport %}<button type="button" role="tab" id="apps-tab-netsec" aria-controls="netsec" data-apps-tab="netsec" class="apps-tab-netsec">{{ d.netsec.tab }}</button>{% endif %}
        {% if systemHealth %}<button type="button" role="tab" id="apps-tab-it" aria-controls="it" data-apps-tab="it" data-roles="staff">{{ d.tabIt }} <span class="apps-dot apps-dot-{{ systemHealth.summary.level }}" data-apps-it-dot aria-hidden="true"{% if not systemHealth.summary.url %} hidden{% endif %}></span><span class="sr-only" data-apps-it-note{% if not systemHealth.summary.url %} hidden{% endif %}>{{ d.needsAttention }}</span></button>{% endif %}
      </div>
      <div class="apps-viewing">
        <label for="apps-role">{{ d.viewingAs }}</label>
        <select class="apps-role" id="apps-role">
          <option value="all" selected>{{ d.roles.all }}</option>
          <option value="staff">{{ d.roles.staff }}</option>
          <option value="management">{{ d.roles.management }}</option>
          <option value="board">{{ d.roles.board }}</option>
          <option value="volunteer">{{ d.roles.volunteer }}</option>
        </select>
      </div>
    </div>

    <section class="apps-panel" id="apps" data-apps-panel aria-labelledby="apps-heading">
      <div class="apps-panel-head">
        <div>
          <h2 class="apps-heading" id="apps-heading">{{ d.yourApps }}</h2>
          <p class="apps-count" data-apps-total role="status" hidden></p>
        </div>
        <div class="apps-filter" data-apps-filter-box hidden>
          <label class="sr-only" for="apps-filter">{{ d.filterApps }}</label>
          <input class="apps-filter-input" id="apps-filter" type="search" placeholder="{{ d.filterApps }}" autocomplete="off" spellcheck="false" data-apps-filter>
        </div>
      </div>

      <ul class="apps-grid" role="list">
        {% set n = 0 %}
        {% for app in site.staffLinks %}{% if app.roles %}
          {% set note = t.staffMenu[app.key + "Note"] or app.note %}
          <li class="apps-card-wrap"{% if app.href %} data-apps-app{% endif %} data-roles="{{ app.roles | join(' ') }}" style="--n: {{ n }}">
            {% if app.href %}
              <a class="apps-tile" href="{{ app.href }}">
                <span class="apps-icon">{{ icon(app.icon) }}{% if app.badge %}<span class="apps-badge">{{ app.badge }}</span>{% endif %}</span>
                <span class="apps-label">{{ t.staffMenu[app.key] or app.label }}</span>
                {% if note %}<span class="apps-note">{{ note }}</span>{% endif %}
                <span class="apps-go">{{ icon("arrow-right") }}</span>
              </a>
            {% else %}
              <div class="apps-tile apps-tile-soon">
                <span class="apps-icon">{{ icon(app.icon) }}</span>
                <span class="apps-label">{{ app.label }}</span>
                {% if note %}<span class="apps-note">{{ note }}</span>{% endif %}
              </div>
            {% endif %}
          </li>
          {% set n = n + 1 %}
        {% endif %}{% endfor %}
      </ul>
      <p class="apps-note apps-filter-empty" data-apps-filter-empty hidden></p>
    </section>

    <section class="apps-panel" id="guides" data-apps-panel aria-labelledby="apps-guides-heading">
      <h2 class="apps-heading apps-section-heading" id="apps-guides-heading">{{ d.tabGuides }}</h2>
      <ul class="apps-grid" role="list">
        {% for guide in site.guideLinks %}
          <li class="apps-card-wrap" data-roles="{{ guide.roles | join(' ') }}" style="--n: {{ loop.index0 }}">
            <a class="apps-tile apps-tile-short" href="{{ guide.href | localizedHref(lang) }}">
              <span class="apps-icon">{{ icon(guide.icon) }}</span>
              <span class="apps-label">{{ (guide[lang] and guide[lang].label) or guide.label }}</span>
              <span class="apps-go">{{ icon("arrow-right") }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </section>

    <section class="apps-panel" id="status" data-apps-panel aria-labelledby="apps-status-heading">
      <h2 class="apps-heading apps-section-heading" id="apps-status-heading">{{ d.tabStatus }}</h2>
      <div class="apps-status">
        {% if dashboard.release %}
          <div class="apps-status-card" data-roles="staff">
            {{ SRC | replace("@", "release") | safe }}
            <h3 class="apps-status-title">{{ d.nextRelease }}</h3>
            <p class="apps-release"><a href="{{ dashboard.release.url }}">{{ dashboard.release.title }}</a>{% if dashboard.release.due %}{{ d.dueOn | replace("{date}", dashboard.release.due | newsDate(lang)) }}{% endif %}</p>
            <div class="apps-progress-wrap">
              <progress class="apps-progress" data-apps-release-bar value="{{ dashboard.release.closed }}" max="{{ dashboard.release.total }}" aria-label="{{ d.progress | replace("{title}", dashboard.release.title) }}">{{ dashboard.release.percent }}%</progress><span class="apps-progress-new" data-apps-release-new hidden></span></div>
            <p class="apps-note" data-apps-release-note>{{ d.issuesClosed | replace("{closed}", dashboard.release.closed) | replace("{total}", dashboard.release.total) }}</p>
            <div class="apps-pace" data-apps-pace hidden>
              <p class="apps-pace-summary" data-apps-pace-summary></p>
              <div class="apps-pace-plot">
                <div class="apps-pace-bars" data-apps-pace-bars aria-hidden="true"></div>
                <p class="apps-pace-tip" data-apps-pace-tip hidden></p>
              </div>
              <p class="apps-pace-axis" aria-hidden="true"><span>{{ d.daysAgo30 }}</span><span>{{ d.today }}</span></p>
              <details class="apps-pace-table">
                <summary>{{ d.daysWithClosures }}</summary>
                <table>
                  <thead><tr><th scope="col">{{ d.day }}</th><th scope="col">{{ d.issuesClosedCol }}</th></tr></thead>
                  <tbody data-apps-pace-rows></tbody>
                </table>
              </details>
            </div>
          </div>
        {% endif %}
        {% if dashboard.counts %}
          <div class="apps-status-card" data-roles="staff volunteer">
            {{ SRC | replace("@", "counts") | safe }}
            <h3 class="apps-status-title">{{ d.onGithub }}</h3>
            <ul class="apps-counts" role="list">
              {% for c in dashboard.counts %}
                <li data-roles="{{ c.roles | join(' ') }}"><a href="{{ c.url }}"><strong data-apps-live="{{ ['issues', 'prs', 'tasks'][loop.index0] }}">{{ c.value }}</strong> {{ d.counts[c.key] }}</a></li>
              {% endfor %}
            </ul>
            <ul class="apps-help" data-apps-help role="list" aria-label="{{ d.newestTasks }}"{% if not dashboard.help.length %} hidden{% endif %}>
              {% for x in dashboard.help %}<li><a href="{{ x.url }}"><span class="apps-help-num">#{{ x.n }}</span> {{ x.title }}</a></li>{% endfor %}
            </ul>
          </div>
        {% endif %}
        {# The coming release milestones, from the GitHub milestones. The
           conference and internship dates are under Timeline. #}
        {% if dashboard.milestones.length %}
          <div class="apps-status-card">
            {{ SRC | replace("@", "") | safe }}
            <h3 class="apps-status-title">{{ d.nextMilestones }}</h3>
            <ol class="apps-timeline" data-apps-timeline>
              {% for m in dashboard.milestones %}
                {% if m.state == "next" %}<li class="apps-timeline-today" data-apps-timeline-today aria-hidden="true"><span>{{ d.today }}</span></li>{% endif %}
                <li class="apps-timeline-item apps-timeline-{{ m.state }}" data-roles="staff management board volunteer" data-date="{{ m.date }}"><span class="apps-timeline-dot" aria-hidden="true"></span><time datetime="{{ m.date }}">{{ m.date | newsDate(lang) }}</time> <span class="apps-timeline-label"><a href="{{ m.url }}">{{ d.releaseDue | replace("{title}", m.title) }}</a></span><span class="apps-timeline-when" data-apps-timeline-when></span>
                  <span class="apps-timeline-detail"><progress class="apps-progress" value="{{ m.closed }}" max="{{ m.total }}" aria-label="{{ d.progress | replace("{title}", m.title) }}">{{ m.percent }}%</progress>{{ d.issuesClosed | replace("{closed}", m.closed) | replace("{total}", m.total) }} ({{ m.percent }}%)</span></li>
              {% endfor %}
            </ol>
          </div>
        {% endif %}
      </div>
    </section>

    {# The NetSec monthly report for the last complete month, recomputed at
       build by src/_data/netsecReport.js. Names and titles stay as the NetSec
       data and the commits give them. #}
    {% set R = netsecReport %}
    {% if R %}
      {% set N = d.netsec %}
      {% set W = R.website %}
      <section class="apps-panel apps-netsec" id="netsec" data-apps-panel aria-labelledby="apps-netsec-heading">
        <h2 class="apps-heading apps-section-heading" id="apps-netsec-heading">{{ N.heading | replace("{month}", R.start | monthYear(lang)) }}</h2>
        <p class="apps-note">{{ N.lead }}</p>
        <div class="apps-status">
          <div class="apps-status-card">
            {{ SRC | replace("@", "") | safe }}
            <h3 class="apps-status-title">{{ N.directory }}</h3>
            <p class="apps-netsec-figure">{{ N.profiles | replace("{from}", R.directory.from) | replace("{to}", R.directory.to) }}</p>
            <p>{{ N.joinedLeft | replace("{joined}", R.directory.joined.length) | replace("{left}", R.directory.left.length) }}</p>
            {% for key in ["joined", "left"] %}{% if R.directory[key].length %}
              <details class="apps-netsec-more"{% if key == "joined" %} open{% endif %}>
                <summary>{{ N.profileLists[key] }} ({{ R.directory[key].length }})</summary>
                <ul class="apps-netsec-list" role="list">
                  {% for m in R.directory[key] %}<li><a href="{{ m.url }}">{{ m.name }}</a><span>{{ m.affiliation }} ({{ m.country }})</span></li>{% endfor %}
                </ul>
              </details>
            {% endif %}{% endfor %}
          </div>

          <div class="apps-status-card">
            {{ SRC | replace("@", "") | safe }}
            <h3 class="apps-status-title">{{ N.leadership }}</h3>
            <h4 class="apps-netsec-sub">{{ N.coreGroup }}</h4>
            <ul class="apps-netsec-list" role="list">
              {% for c in R.coreGroup %}
                <li>{% if c.kind == "appointed" %}{{ N.appointed | replace("{name}", c.name) | replace("{role}", c.role) }}{% elif c.kind == "left" %}{{ N.noLonger | replace("{name}", c.name) | replace("{role}", c.role) }}{% else %}{{ N.post | replace("{role}", c.role) | replace("{was}", c.was or N.vacant) | replace("{now}", c.now or N.vacant) }}{% endif %}</li>
              {% else %}
                <li>{{ N.noChange }}</li>
              {% endfor %}
            </ul>
            <h4 class="apps-netsec-sub">{{ N.mc }}</h4>
            <p>{{ N.representatives | replace("{from}", R.committee.from) | replace("{to}", R.committee.to) }}</p>
            {% for key in ["joined", "left"] %}{% if R.committee[key].length %}
              <p><strong>{{ N[key] }}:</strong> {% for m in R.committee[key] %}{{ m.name }} ({{ m.country }}){% if not loop.last %}, {% endif %}{% endfor %}</p>
            {% endif %}{% endfor %}
          </div>

          <div class="apps-status-card">
            {{ SRC | replace("@", "") | safe }}
            <h3 class="apps-status-title">{{ N.groups }}</h3>
            {% for g in R.groups %}
              <h4 class="apps-netsec-sub">WG{{ g.number }} {{ g.name }}</h4>
              <p>{% if g.from == g.to %}{{ N.unchanged | replace("{n}", g.to) }}{% else %}{{ N.changed | replace("{from}", g.from) | replace("{to}", g.to) | replace("{delta}", ("+" if g.to > g.from else "") + (g.to - g.from)) }}{% endif %}<br>
              <span class="apps-netsec-muted">{% if g.lead %}{{ N.leader | replace("{name}", g.lead) }}{% endif %}{% if g.lead and g.coLead %}, {% endif %}{% if g.coLead %}{{ N.coLeader | replace("{name}", g.coLead) }}{% endif %}</span></p>
              {% for key in ["joined", "left"] %}{% if g[key].length %}
                <p class="apps-netsec-muted"><strong>{{ N[key] }}:</strong> {% for m in g[key] %}{{ m.name }} ({{ m.country }}){% if not loop.last %}, {% endif %}{% endfor %}</p>
              {% endif %}{% endfor %}
            {% endfor %}
          </div>

          <div class="apps-status-card">
            {{ SRC | replace("@", "") | safe }}
            <h3 class="apps-status-title">{{ N.website }}</h3>
            <p class="apps-netsec-figure">{{ N.prs | replace("{n}", W.merged) }}</p>
            <p>{{ N.tally | replace("{features}", W.features) | replace("{fixes}", W.fixes) | replace("{data}", W.data) | replace("{add}", W.add | thousands(lang)) | replace("{del}", W.del | thousands(lang)) }}</p>
            {% for key in ["majorFeatures", "notableFixes"] %}{% if W[key].length %}
              <h4 class="apps-netsec-sub">{{ N[key] }}</h4>
              <ul class="apps-netsec-list" role="list">
                {% for x in W[key] %}<li>{% if x.url %}<a href="{{ x.url }}">{{ x.title }}</a>{% else %}{{ x.title }}{% endif %}<span>{% if x.pr %}#{{ x.pr }}, {% endif %}+{{ x.add | thousands(lang) }}/−{{ x.del | thousands(lang) }}</span></li>{% endfor %}
              </ul>
            {% endif %}{% endfor %}
            <h4 class="apps-netsec-sub">{{ N.contributors }}</h4>
            <ul class="apps-netsec-list" role="list">
              {% for c in W.contributors %}<li>{{ c.who }}<span>{{ N.commits[0 if c.commits == 1 else 1] | replace("{n}", c.commits) }}</span></li>{% endfor %}
            </ul>
          </div>
        </div>
        <p class="apps-note">{{ N.period | replace("{start}", R.start | newsDate(lang)) | replace("{end}", R.end | newsDate(lang)) | replace("{a}", R.commits[0]) | replace("{b}", R.commits[1]) }}</p>
      </section>
    {% endif %}

    {% if systemHealth %}
      <section class="apps-panel apps-health" id="it" data-apps-panel aria-labelledby="apps-health-heading" data-roles="staff">
        <h2 class="apps-heading apps-section-heading" id="apps-health-heading">{{ d.itHeading }}</h2>
        <div class="apps-status">
          {% for repo in systemHealth.repos %}
            <div class="apps-status-card">
              {{ SRC | replace("@", "runs") | safe }}
              <h3 class="apps-status-title apps-health-brand">
                <a href="{{ repo.site }}" aria-label="{{ repo.label }}">
                  {% if loop.first %}<span aria-hidden="true">{% inlineSvg "assets/images/brand/logo-lockup.svg" %}</span>{% else %}<img src="/assets/images/partners/netsec.svg#svgView(viewBox(360,780,2800,930))" alt="" width="120" height="40">{% endif %}
                </a>
              </h3>
              <p class="apps-health-level" data-apps-repo-level="{{ repo.slug }}"><span class="apps-dot apps-dot-{{ repo.level }}" aria-hidden="true"></span><span>{{ d.levels[repo.level] }}</span></p>
              <p class="apps-health-summary" data-apps-repo-summary="{{ repo.slug }}">{% if repo.failedCount %}{{ d.automationsFailing | replace("{bad}", repo.failedCount) | replace("{n}", repo.items.length) }}{% else %}{{ d.automationsOk | replace("{n}", repo.items.length) }}{% endif %}</p>
              <details class="apps-health-details" data-apps-repo-details="{{ repo.slug }}"{% if repo.failedCount %} open{% endif %}>
                <summary>{{ d.everyAutomation }}</summary>
                <ul class="apps-health-list" role="list">
                  {% for item in repo.items %}
                    <li class="apps-health-item{% if item.failed %} apps-health-failed{% endif %}" data-apps-run="{{ repo.slug }}|{{ item.name }}"><span class="apps-dot apps-dot-{{ item.level }}" aria-hidden="true"></span><div><a href="{{ item.url }}">{{ item.name }}</a> <span>{{ d.levels[item.level] }}{% if item.date %}, {{ item.date | newsDate(lang) }}{% endif %}</span></div></li>
                  {% endfor %}
                </ul>
              </details>
            </div>
          {% endfor %}
          {% set gh = systemHealth.github %}
          <div class="apps-status-card">
            {{ SRC | replace("@", "ghstatus") | safe }}
            <h3 class="apps-status-title">GitHub</h3>
            <p class="apps-health-level" data-apps-github-level><span class="apps-dot apps-dot-{{ gh.level if gh else 'unknown' }}" aria-hidden="true"></span><span>{{ d.levels[gh.level if gh else 'unknown'] }}</span></p>
            <p class="apps-health-summary"><a href="https://www.githubstatus.com/">{{ d.githubServices }}</a> <span data-apps-github-text>{% if gh %}{{ d.levels[gh.level] }}{% if gh.components.length %}: {{ gh.components | join(", ") }}{% endif %}{% else %}{{ d.unreadable }}{% endif %}</span></p>
          </div>
          <div class="apps-status-card">
            {{ SRC | replace("@", "") | safe }}
            <h3 class="apps-status-title">Google Workspace</h3>
            <p class="apps-health-level"><span class="apps-dot apps-dot-{{ systemHealth.workspace.level }}" aria-hidden="true"></span>{{ d.levels[systemHealth.workspace.level] }}</p>
            <ul class="apps-health-list" role="list">
              {% if systemHealth.google %}
                <li class="apps-health-item"><span class="apps-dot apps-dot-{{ systemHealth.google.level }}" aria-hidden="true"></span><div><a href="https://www.google.com/appsstatus/dashboard/">{{ d.googleServices }}</a> <span>{{ d.levels[systemHealth.google.level] }}{% if systemHealth.google.services.length %}: {{ systemHealth.google.services | join(", ") }}{% endif %}</span></div></li>
              {% else %}
                <li><a href="https://www.google.com/appsstatus/dashboard/">{{ d.googleServices }}</a> <span>{{ d.unreadable }}</span></li>
              {% endif %}
              {% if systemHealth.workspace.checks %}
                {% for check in systemHealth.workspace.checks %}
                  <li class="apps-health-item"><span class="apps-dot apps-dot-{{ check.level }}" aria-hidden="true"></span><div><a href="https://script.google.com/home/executions">{{ check.name }}</a> <span>{{ d.levels[check.level] or check.label }}{% if check.date %}{{ d.lastGoodRun | replace("{date}", check.date | newsDate(lang)) }}{% endif %}</span></div></li>
                {% endfor %}
              {% else %}
                <li><a href="https://script.google.com/home/executions">{{ d.appsScriptRuns }}</a> <span>{{ d.unreadable }}</span></li>
              {% endif %}
              <li><a href="https://admin.google.com/ac/ac">{{ d.securityAlerts }}</a> <span>{{ d.notMonitored }}</span></li>
            </ul>
          </div>
        </div>
        <p class="apps-note" data-apps-asof>{{ d.asOf | replace("{date}", systemHealth.checked | newsDate(lang)) }}.</p>
      </section>
    {% endif %}

    {# The dashboard's own version. Rules and history: docs/internal-dashboard.md. #}
    <p class="apps-legend" aria-hidden="true"><span><span class="apps-src is-live"></span> {{ d.live }}</span> <span><span class="apps-src"></span> {{ STORED }}</span></p>
    <p class="apps-version">{{ d.version | replace("{v}", dashboard.version) }}</p>
  </div>
</div>

<script type="application/json" id="apps-i18n">{{ d.js | dump | safe }}</script>
<script type="application/json" id="apps-dash">{{ { next: d.next, finish: d.finish, today: d.today, done: d.done, levels: d.levels, automationsFailing: d.automationsFailing, automationsOk: d.automationsOk, issuesClosed: d.issuesClosed } | dump | safe }}</script>
<script type="application/json" id="apps-data">{{ { deadlines: dashboard.deadlines, release: dashboard.release, counts: dashboard.counts, repo: dashboard.repo, recent: dashboard.recent, health: systemHealth } | dump | safe }}</script>
<script>
  (function () {
    var calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
    // The page's language: strings from t.dash.js, a {name} slot filler and a
    // plural picker (French counts 0 and 1 as singular).
    var I = JSON.parse(document.getElementById("apps-i18n").textContent), LOC = I.locale;
    var DASH = JSON.parse(document.getElementById("apps-dash").textContent);
    function f(s, o) { return s.replace(/\{(\w+)\}/g, function (m, k) { return k in o ? o[k] : m; }); }
    function pl(pair, n, o) { var one = LOC === "fr-FR" ? n < 2 : n === 1; return f(pair[one ? 0 : 1], Object.assign({ n: n }, o)); }

    // Remember the role choice and report how many apps it leaves. The
    // filtering itself is CSS.
    var KEY = "eiss-apps-role";
    var roleSelect = document.getElementById("apps-role");
    var total = document.querySelector("[data-apps-total]");
    var saved = null;
    try { saved = localStorage.getItem(KEY); } catch (e) {}
    function tally() {
      var shown = [].filter.call(document.querySelectorAll("[data-apps-app]"), function (el) {
        return getComputedStyle(el).display !== "none";
      }).length;
      total.textContent = pl(I.app, shown);
      total.hidden = false;
    }
    // A link can carry the role (?role=board) to open someone on their view. It
    // applies to that visit only: the saved role and the first-visit welcome
    // still follow localStorage. The address bar shows the role on view, so it
    // can be copied and sent.
    function isRole(r) { return r && roleSelect.querySelector('[value="' + CSS.escape(r) + '"]'); }
    function roleToUrl() {
      var u = new URL(location.href);
      if (roleSelect.value === "all") u.searchParams.delete("role"); else u.searchParams.set("role", roleSelect.value);
      history.replaceState(null, "", u);
    }
    var linked = new URLSearchParams(location.search).get("role");
    if (isRole(linked)) roleSelect.value = linked;
    else if (isRole(saved)) roleSelect.value = saved;
    roleToUrl();
    roleSelect.addEventListener("change", function () {
      try { localStorage.setItem(KEY, roleSelect.value); } catch (e) {}
      roleToUrl();
      tally();
      renderToday();
      renderTimeline(false);
      keepTabVisible();
    });
    tally();

    // The welcome dialog. It opens once per device, on a first visit with no
    // role saved, and from any link to #welcome. Choosing a role sets the
    // role menu, which also filters the steps' links.
    var WELCOMED = "eiss-apps-welcomed";
    var dlg = document.querySelector("[data-apps-welcome]");
    var roleBox = dlg.querySelector("[data-apps-welcome-role]");
    var stepBox = dlg.querySelector("[data-apps-welcome-steps]");
    var allSteps = [].slice.call(dlg.querySelectorAll(".apps-welcome-step"));
    var wMeta = dlg.querySelector("[data-apps-welcome-meta]");
    var wBar = dlg.querySelector("[data-apps-welcome-bar]");
    var wBack = dlg.querySelector("[data-apps-welcome-back]");
    var wNext = dlg.querySelector("[data-apps-welcome-next]");
    var wSteps = [], wAt = 0;
    function openWelcome() {
      roleBox.hidden = false;
      stepBox.hidden = true;
      if (!dlg.open) dlg.showModal();
    }
    function wShow(i) {
      wAt = i;
      allSteps.forEach(function (li) { li.classList.toggle("apps-welcome-on", li === wSteps[i]); });
      wMeta.textContent = f(I.stepOf, { stage: wSteps[i].getAttribute("data-stage"), i: i + 1, n: wSteps.length });
      wBar.max = wSteps.length;
      wBar.value = i + 1;
      wBack.hidden = i === 0;
      wNext.textContent = i === wSteps.length - 1 ? DASH.finish : DASH.next;
      wSteps[i].querySelector(".apps-welcome-heading").focus();
    }
    dlg.addEventListener("click", function (e) {
      var t = e.target.closest("button");
      if (!t) return;
      var role = t.getAttribute("data-apps-choose");
      if (role) {
        roleSelect.value = role;
        roleSelect.dispatchEvent(new Event("change"));
        wSteps = allSteps.filter(function (li) { return li.getAttribute("data-roles").split(" ").indexOf(role) >= 0; });
        roleBox.hidden = true;
        stepBox.hidden = false;
        wShow(0);
      } else if (t.hasAttribute("data-apps-welcome-close")) dlg.close();
      else if (t === wBack) wShow(wAt - 1);
      else if (t === wNext) { if (wAt < wSteps.length - 1) wShow(wAt + 1); else dlg.close(); }
    });
    dlg.addEventListener("close", function () {
      try { localStorage.setItem(WELCOMED, "1"); } catch (e) {}
      // Opened on load, the dialog has no earlier focus to return to.
      var f = document.activeElement;
      if (f === document.body || dlg.contains(f)) tablist.querySelector('[aria-selected="true"]').focus();
    });
    document.addEventListener("click", function (e) {
      var a = e.target.closest && e.target.closest('a[href="#welcome"]');
      if (!a) return;
      e.preventDefault();
      openWelcome();
    });
    var welcomed = null;
    try { welcomed = localStorage.getItem(WELCOMED); } catch (e) {}
    if (saved === null && !welcomed && dlg.showModal) openWelcome();

    // Tabs. Without this script they stay hidden and every section stacks.
    // Each has its own link, and the page always opens on Apps otherwise.
    var tablist = document.querySelector("[data-apps-tabs]");
    var tabs = [].slice.call(tablist.querySelectorAll("[role=tab]"));
    var panels = [].slice.call(document.querySelectorAll("[data-apps-panel]"));
    function isTab(name) { return tabs.some(function (t) { return t.getAttribute("data-apps-tab") === name; }); }
    function selectTab(name) {
      tabs.forEach(function (t) {
        var on = t.getAttribute("data-apps-tab") === name;
        t.setAttribute("aria-selected", on);
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach(function (panel) { panel.hidden = panel.id !== name; });
    }
    // Switching tabs crossfades the panels where the browser has View
    // Transitions. Elsewhere, and under reduced motion, they swap at once.
    function switchTab(name) {
      if (calm || !document.startViewTransition) selectTab(name);
      else document.startViewTransition(function () { selectTab(name); });
    }
    function usable() { return tabs.filter(function (t) { return getComputedStyle(t).display !== "none"; }); }
    function keepTabVisible() {
      if (usable().indexOf(tablist.querySelector('[aria-selected="true"]')) < 0) {
        selectTab("apps");
        history.replaceState(null, "", location.pathname + location.search);
      }
    }
    panels.forEach(function (panel) {
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", "apps-tab-" + panel.id);
    });
    tablist.hidden = false;
    selectTab(isTab(location.hash.slice(1)) ? location.hash.slice(1) : "apps");
    keepTabVisible();
    tablist.addEventListener("click", function (e) {
      var tab = e.target.closest("[role=tab]");
      if (!tab) return;
      var name = tab.getAttribute("data-apps-tab");
      switchTab(name);
      history.replaceState(null, "", "#" + name);
    });
    tablist.addEventListener("keydown", function (e) {
      var list = usable(), i = list.indexOf(document.activeElement);
      var to = e.key === "ArrowRight" ? (i + 1) % list.length : e.key === "ArrowLeft" ? (i - 1 + list.length) % list.length : e.key === "Home" ? 0 : e.key === "End" ? list.length - 1 : -1;
      if (to < 0) return;
      e.preventDefault();
      list[to].focus();
      list[to].click();
    });
    addEventListener("hashchange", function () {
      var name = location.hash.slice(1);
      if (!isTab(name)) return;
      switchTab(name);
      keepTabVisible();
      tablist.scrollIntoView({ block: "nearest" });
    });

    // Greeting and clock, in the reader's own time zone.
    var clock = document.querySelector("[data-apps-clock]");
    function tick() {
      var d = new Date(), h = d.getHours();
      var hello = h < 5 ? I.evening : h < 12 ? I.morning : h < 18 ? I.afternoon : I.evening;
      clock.textContent = hello + ". " +
        d.toLocaleDateString(LOC, { weekday: "long", day: "numeric", month: "long" }) + ", " +
        d.toLocaleTimeString(LOC, { hour: "2-digit", minute: "2-digit" });
      clock.hidden = false;
      setTimeout(tick, 60000 - d.getSeconds() * 1000);
    }
    tick();

    // Day counts stay right between daily rebuilds. Figures count up once.
    function daysTo(iso) {
      var p = iso.split("-"), now = new Date();
      return Math.round((Date.UTC(p[0], p[1] - 1, p[2]) - Date.UTC(now.getFullYear(), now.getMonth(), now.getDate())) / 864e5);
    }
    function inDays(n) { return n === 0 ? DASH.today : pl(I.day, n); }
    var cd = document.querySelector("[data-apps-countdown]");
    if (cd) {
      var days = daysTo(cd.getAttribute("data-apps-countdown"));
      if (days < 0) cd.closest(".apps-stat").hidden = true; else cd.textContent = days;
    }

    var data = JSON.parse(document.getElementById("apps-data").textContent);

    // The Key dates timeline, kept right between daily builds: dates over 30
