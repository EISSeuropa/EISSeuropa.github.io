---
layout: base.njk
permalink: /index.fr.html
title: false
homeTitle: Initiative européenne pour les études de sécurité (EISS)
description: Nous sommes le plus grand et le plus divers rassemblement européen de chercheurs et praticiens sur les questions de sécurité.
metaImage: /assets/images/index-meta.jpg
navKey: home
lang: fr
status: beta
alternates:
  en: /
  fr: /index.fr.html
  de: /index.de.html
---
{% from "icons.njk" import icon %}

<section class="hero" aria-labelledby="hero-title">
  {%- set heroImg = conferences.heroEdition.heroImage if conferences.heroEdition %}
  {%- if heroImg %}
  <div class="hero-bg" aria-hidden="true">
    <img src="{{ heroImg }}-1600x900.jpg"
         srcset="{{ heroImg }}-480x270.jpg 480w,
                 {{ heroImg }}-800x450.jpg 800w,
                 {{ heroImg }}-1600x900.jpg 1600w"
         sizes="100vw"
         alt=""
         loading="eager"
         fetchpriority="high"
         width="1600" height="900">
  </div>
  {%- endif %}
  <div class="container hero-inner">
    <h1 id="hero-title" class="reveal">L'Initiative européenne pour les études de sécurité</h1>
    <p class="hero-tagline reveal reveal-delay-1">
      Le plus grand et le plus divers rassemblement européen de chercheurs et praticiens sur les questions de sécurité.
    </p>
    <div class="hero-actions reveal reveal-delay-2">
      {%- if conferences.next %}
      <a class="btn btn-primary" href="/{{ conferences.next.slug }}.fr.html">Découvrir l'ESSC {{ conferences.next.year }} {{ icon("arrow-right") }}</a>
      {%- else %}
      {# Between editions there is no conference page to point at yet, so the
         newsletter (where the next one is announced first) takes the slot. #}
      <a class="btn btn-primary" href="{{ site.newsletterUrl }}" target="_blank" rel="noopener">{{ icon("bell") }} S'abonner à notre lettre d'information</a>
      {%- endif %}
      <a class="btn btn-ghost" href="/initiative.fr.html">À propos de l'Initiative</a>
    </div>
    <p class="hero-links reveal reveal-delay-3">
      {%- if conferences.next %}
      <a href="{{ site.newsletterUrl }}" target="_blank" rel="noopener">{{ icon("bell", "icon-inline") }}S'abonner à notre lettre d'information</a>
      {%- endif %}
      <a href="{{ site.social.youtube }}" target="_blank" rel="noopener">{{ icon("youtube", "icon-inline") }}Suivre notre chaîne YouTube</a>
      <a href="mailto:{{ site.contactEmail }}">{{ icon("mail", "icon-inline") }}Nous contacter</a>
    </p>
  </div>
</section>

{% include "home-stats.njk" %}

{% set conf = conferences.next %}
{% if conf %}
<section class="section" aria-labelledby="featured-title">
  <div class="container">
    <article class="card featured">
      <div>
        <div class="featured-eyebrow">Prochaine conférence</div>
        <h2 id="featured-title">European Security Studies Conference {{ conf.year }}</h2>
        {% set year = conf.year %}
        {% include "countdown.njk" %}
        <p class="featured-orgs">
          {{ conf.organisers.fr }}
        </p>
        <div class="featured-meta">
          <div>
            <strong>{{ icon("calendar", "icon-inline") }}Dates</strong>
            {{ conf.dates.fr }}
          </div>
          <div>
            <strong>{{ icon("map-pin", "icon-inline") }}Lieu</strong>
            {{ conf.venue.fr }}
          </div>
        </div>
        <div class="featured-registration">
          {%- set hideBadgeCta = conf.livestreamUrl and conf.endDate >= conferences.today -%}
          {% include "registration-badge.njk" %}
          {%- if conf.livestreamUrl and conf.endDate >= conferences.today %}
          <a class="programme-live-tag" href="{{ conf.livestreamUrl }}" target="_blank" rel="noopener">{{ icon("video") }} En direct {{ icon("external-link") }}</a>
          {%- endif %}
        </div>
        <div>
          <a class="btn btn-primary" href="/{{ conf.slug }}.fr.html">En savoir plus sur l'ESSC&nbsp;{{ conf.year }} {{ icon("arrow-right") }}</a>
        </div>
      </div>
      <aside class="featured-date" aria-hidden="true">
        <div class="month">{{ conf.monthLabel.fr }}</div>
        <div class="day">{{ conf.dayRange | replace("–", "<span aria-hidden='true'>–</span>") | safe }}</div>
        <div class="year">{{ conf.year }} · {{ conf.city }}</div>
      </aside>
    </article>
  </div>
</section>
{% endif %}

{% set limit = 5 %}
{% include "indico-events-list.njk" %}

{% include "announcement-card.njk" %}

{% include "news-latest.njk" %}

{% include "home-film.njk" %}

{% include "home-paper.njk" %}

{% set promoHideStats = true %}
{% include "navigator-promo.njk" %}

<section class="section" aria-labelledby="join-title">
  <div class="container">
    <div class="join">
      <h2 id="join-title">Rejoignez-nous</h2>
      <p>
        Les membres ont accès aux événements des membres : séminaires et présentations d'ouvrages organisés par la communauté EISS.
        Les billets pour notre conférence annuelle incluent déjà une adhésion d'un an.
      </p>
      <div class="join-actions">
        <a class="btn btn-primary" href="/membership.fr.html#become-a-member">{{ icon("user-plus") }} Devenir membre</a>
        <a class="btn btn-secondary" href="https://billing.stripe.com/p/login/3cscOuaesfHceC4dQQ" target="_blank" rel="noopener">
          Gérer mon adhésion {{ icon("external-link") }}
        </a>
      </div>
    </div>
  </div>
</section>
