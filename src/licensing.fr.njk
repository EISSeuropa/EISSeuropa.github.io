          <a href="https://lucide.dev" target="_blank" rel="noopener">lucide.dev</a>
        </li>
        <li>
          <strong>Police Inter</strong> — SIL Open Font License 1.1 —
          <a href="https://rsms.me/inter/" target="_blank" rel="noopener">rsms.me/inter</a>
        </li>
      </ul>
      <p>{{ t.licensing.thirdPartyImages }}</p>

      <h2>{{ t.licensing.questionsHeading }}</h2>
      <p>
        {{ t.licensing.questionsBody }}
        <a href="mailto:{{ site.contactEmail }}">{{ site.contactEmail }}</a>.
      </p>

    </article>
  </div>
</section>
